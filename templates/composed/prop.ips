// __STEM__.ips — <one line: what this prop is and where a game uses it>.
//
// One part per characteristic feature, stacked from the ground up:
//__FEATURE_LIST__
// materials.ips holds the looks the features share.
//
// A seed alone gives a different __NAME__: <the families, the proportions,
// the colours and the details the seed rolls>.
// Variety: __VARIETY__ (references/variety.md says what each level adds)
//
// Inputs:
//   kind   0 rolls; 1 slim, 2 wide, 3 tall
//   tint   transparent rolls the main colour; any other colour sets it
// Outputs:
//__OUTPUT_DOCS__

//__IMPORTS__
import looks from "materials.ips"

asset __NAME__ {
  size __W__x__H__
  origin __OX__, __OY__
  input u32 kind = 0                // 0 rolls; 1 slim, 2 wide, 3 tall
  input color tint = #00000000      // transparent rolls one
  //__OUTPUT_DECLS__

  // Proportions cluster around the typical one; extremes stay rare.
  const distribution typical = gaussian(mean = 0.5, sigma = 0.18)
  const distribution kinds = weighted {1: 45, 2: 35, 3: 20}
  const f32 cx = __OX__.0
  const f32 ground = __OY__.0
  const f32 maxHalf = __HALF__.0
  const f32 maxTall = __TALL__.0
  // Stream keys, one per purpose: hash(start ^ key) seeds that purpose's
  // stream, and every feature's part draws from a key of its own. Keep them
  // fixed once a game stores seeds; give a new feature a new key.
  const i32 kindKey = 0x2f6b9a13
  const i32 shapeKey = 0x51ed2701
  const i32 colorKey = 0x6c8e9cf5
  //__KEYS__

  draw {
    start = seed                      // the game's seed, before any draw moves it

    // A rolled kind hashes the seed, so it renders exactly like the same
    // kind forced.
    look = clamp(kind, 0, 3)
    if (look == 0) { look = rolledKind(start) }

    // The shape has a stream of its own: every feature's size is rolled up
    // front, whatever the kind, so adding a feature never moves the others.
    stream_push(hash(start ^ shapeKey))
    half = lerp(maxHalf * 0.55, maxHalf, 0.0 to 1.0 with typical)
    tall = lerp(maxTall * 0.6, maxTall, 0.0 to 1.0 with typical)
    //__SHAPE__
    stream_pop()
    if (look == 1) { half = half * 0.75 }
    if (look == 2) { tall = tall * 0.8 }
    if (look == 3) { half = half * 0.85 }
    //__SIZES__

    // Colours have a stream of their own. Parts take colours, not materials:
    // each builds its material again from the colour it receives.
    stream_push(hash(start ^ colorKey))
    main = looks.Main()
    accent = looks.Accent()
    stream_pop()
    if (tint.a != 0) { main = looks.Main(base = color.set.a(tint, 255)) }

    // Each feature stands on the one below it, at the point that part reports,
    // and draws from its own key.
    mount = {cx, ground}
    //__CALLS__
    //__OUTPUT_SETS__
  }

  // The kind a seed rolls: weighted, in a stream of its own.
  rolledKind(start: i32) -> i32 {
    stream_push(hash(start ^ kindKey))
    look = 1 to 3 with kinds
    stream_pop()
    return look
  }
}
