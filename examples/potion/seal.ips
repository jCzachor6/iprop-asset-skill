// seal.ips — apothecary closures rest against the shoulder on a short neck
// binding. Local origin is the ornament centre; placement and the attachment
// offsets come from the root so the same part fits every bottle family.
// Styles: 1 wax, 2 folded paper, 3 brass medallion. Twine, wax, paper and
// brass come from the potion's material library.

import mats from "materials.ips"

asset BottleSeal {
  size 32x24
  origin 16,12
  input u32 style = 1
  input u32 stamp = 0
  input f32 neckDX = -5.0
  input f32 neckDY = -6.0
  input f32 neckHalf = 4.0
  input color tint = #ba4340

  draw {
    // Every material is created, whatever the style. The wax takes a
    // little of the liquid's colour; its shade and light follow.
    twine = mats.Twine()
    wax = mats.Wax()
    wax = mats.Wax(base = color.mix(wax.base, tint, 0.14))
    paper = mats.Paper()
    brass = mats.Brass()
    binding = stepper(twine.deep to twine.light).pick(4)
    x = 16.0
    y = 12.0
    tieX = x + neckDX
    tieY = y + neckDY
    // A two-pixel wrap with a lit upper stitch, never a loose looping chain.
    line(tieX - neckHalf, tieY, tieX + neckHalf, tieY, 2, binding[0])
    line(tieX - neckHalf + 0.7, tieY - 0.4, tieX + neckHalf - 0.7, tieY - 0.4, 1, binding[2])
    side = 1.0
    if (neckDX > 0.0) { side = -1.0 }
    start = {tieX + side * (neckHalf - 0.2), tieY}
    end = {x, y - 3.2}
    curve(start, {x - side * 0.8, tieY + 1.7}, end, 2.0, binding[0])
    curve(start + {-0.25, -0.3}, {x - side * 0.8, tieY + 1.2}, end, 1.0, binding[2])
    pixel(int(start.x), int(start.y), binding[3])

    if (style == 1) {
      base = wax.base
      darks = stepper(wax.shadow to base).pick(3)
      lights = stepper(base to wax.light).pick(3)
      tones = [darks[0], darks[1], base, lights[1], lights[2]]
      // Two clipped ribbon ends remain behind the wax, with a clear stamp.
      poly(binding[0], x - 2.3, y + 1.0, x + 2.0, y + 1.0,
           x + 2.4, y + 5.6, x, y + 4.6, x - 2.3, y + 5.4)
      poly(binding[2], x - 1.5, y + 2.0, x + 1.1, y + 2.0,
           x + 1.5, y + 4.1, x, y + 3.5, x - 1.5, y + 4.2)
      poly(tones[0], x - 2.3, y - 3.5, x + 1.6, y - 3.7,
           x + 3.6, y - 1.6, x + 3.6, y + 1.3, x + 1.4, y + 3.5,
           x - 1.8, y + 3.4, x - 3.6, y + 1.2, x - 3.5, y - 1.6)
      oval(x, y - 0.1, 2.9, 2.8, tones[2])
      curve({x - 2.3, y + 0.3}, {x - 2.4, y - 2.4}, {x + 0.9, y - 2.5}, 1, tones[4])
      curve({x - 0.9, y + 2.4}, {x + 2.3, y + 2.4}, {x + 2.5, y - 0.2}, 1, tones[1])
      if (stamp == 0) {
        // A tiny impressed drop: dark inset and a lit lower lip.
        poly(tones[0], x, y - 1.6, x + 1.3, y + 0.5, x, y + 1.4, x - 1.1, y + 0.5)
        pixel(int(x), int(y + 1.0), tones[3])
      } else {
        line(x - 1.0, y - 1.0, x + 1.0, y + 1.0, 1, tones[0])
        line(x - 1.0, y + 1.0, x + 1.0, y - 1.0, 1, tones[0])
        pixel(int(x + 1.0), int(y + 1.0), tones[3])
      }
    } else if (style == 2) {
      tones = stepper(paper.deep to paper.light).pick(6)
      // Cut corners and a folded lower corner distinguish paper from a block.
      poly(tones[0], x - 3.8, y - 2.2, x - 2.3, y - 3.7, x + 3.4, y - 3.0,
           x + 3.9, y + 2.5, x + 2.0, y + 4.2, x - 3.1, y + 3.5)
      poly(tones[4], x - 2.8, y - 2.0, x - 1.8, y - 2.7, x + 2.5, y - 2.1,
           x + 2.8, y + 2.2, x + 1.6, y + 3.2, x - 2.3, y + 2.6)
      line(x - 2.4, y - 2.0, x + 1.9, y - 2.1, 1, tones[5])
      poly(tones[2], x + 1.3, y + 1.5, x + 2.8, y + 2.2, x + 1.6, y + 3.2)
      pixel(int(x - 1.1), int(y - 1.7), binding[0])
      line(x - 1.4, y, x + 1.5, y, 1, tones[1])
      line(x - 1.2, y + 1.4, x + 0.5, y + 1.4, 1, tones[2])
    } else {
      tones = stepper(brass.deep to brass.light).pick(6)
      // A small brass assay medallion has a raised rim and a recessed mark.
      oval(x, y - 3.1, 1.4, 1.7, tones[0])
      oval(x - 0.3, y - 3.5, 0.8, 1.0, tones[4])
      oval(x, y, 3.5, 3.9, tones[0])
      oval(x, y - 0.2, 2.9, 3.2, tones[4])
      oval(x + 0.3, y + 0.2, 2.0, 2.3, tones[1])
      oval(x, y - 0.1, 1.7, 2.0, tones[3])
      curve({x - 2.6, y + 0.4}, {x - 2.8, y - 2.6}, {x + 0.8, y - 3.0}, 1, tones[5])
      if (stamp == 0) {
        line(x, y - 1.1, x, y + 1.0, 1, tones[0])
        line(x - 0.8, y - 0.5, x + 0.9, y - 0.5, 1, tones[0])
      } else {
        poly(tones[0], x, y - 1.5, x + 1.2, y, x, y + 1.5, x - 1.2, y)
      }
      pixel(int(x + 1.0), int(y + 2.0), tones[5])
    }
  }
}
