// neck.ips — the potion neck and its lip.
// Paints absolute 64x64 coordinates; the root passes the geometry.
// Styles: 0 short straight, 1 long slim, 2 flared, 3 curved,
//         4 wide short, 5 ringed, 6 tapered wide->narrow.
// The glass colour comes from the root; the rings are the potion's pewter.

import mats from "materials.ips"

asset Neck {
  size 64x64
  origin 0, 0

  input u32 style = 0
  input f32 cx = 32.0
  input f32 base = 30.0
  input f32 height = 6.0
  input f32 botw = 3.5
  input f32 topw = 3.5
  input color glass = #2e4a60

  draw {
    glass_ffffffTones = tintSteps(glass, #ffffff)
    glass_scaleTones = scaleSteps(glass)
    // Tones match the vessel's empty glass so the neck reads as one piece.
    top = base - height
    outline = mats.Outline()
    dark = outline.base
    pewter = mats.Pewter()
    glassM = lightStep(glass_ffffffTones, 0.16)
    glassL = lightStep(glass_ffffffTones, 0.30)
    neckGlints = tintSteps(glassM, #f4fbff)
    glassT = lightStep(neckGlints, 0.82)
    hatch = lightStep(glass_scaleTones, 0.78)

    if (style == 3) {
      // Curved: two slanted segments with an S offset; the top returns
      // to the centre so the stopper stays aligned.
      mid = base - height * 0.55
      mw = (botw + topw) * 0.5 + 0.6
      slant(cx + 1.0, base + 0.8, cx - 2.0, mid, botw + 1.0, mw + 1.0, dark)
      slant(cx - 2.0, mid, cx, top - 0.4, mw + 1.0, topw + 1.0, dark)
      slant(cx + 1.0, base, cx - 2.0, mid, botw, mw, glassM)
      slant(cx - 2.0, mid, cx, top, mw, topw, glassM)
      line(cx - botw * 0.45, base - 1.0, cx - topw * 0.45, top + 1.5, 1, glassT)
    } else {
      slant(cx, base + 0.8, cx, top - 0.4, botw + 1.0, topw + 1.0, dark)
      slant(cx, base, cx, top, botw, topw, glassM)
      line(cx - botw * 0.45, base - 1.0, cx - topw * 0.45, top + 1.5, 1, glassT)
      line(cx + botw * 0.5, base - 1.5, cx + topw * 0.5, top + 2.0, 1, hatch)
    }

    if (style == 5) {
      ring(cx, base - height * 0.32, botw + 0.7, pewter)
      ring(cx, base - height * 0.72, topw + 0.7, pewter)
    }

    collar(cx, top + 0.2, topw + 1.5, glassL, glassT, dark)
  }

  slant(xa: f32, ya: f32, xb: f32, yb: f32, wa: f32, wb: f32, c: color) {
    poly([{xa - wa, ya}, {xa + wa, ya}, {xb + wb, yb}, {xb - wb, yb}], c)
  }

  ring(ox: f32, oy: f32, w: f32, m: mats.Pewter) {
    rect(ox - w, oy, w * 2.0, 1.6, m.shadow)
    rect(ox - w, oy, w * 2.0, 0.7, m.base)
  }

  // Rounded lip at the top of the neck; the cork plugs into it.
  collar(ox: f32, oy: f32, w: f32, cMain: color, cTop: color, edge: color) {
    oval(ox - w + 1.6, oy + 1.7, 1.9, 2.1, edge)
    oval(ox + w - 1.6, oy + 1.7, 1.9, 2.1, edge)
    rect(ox - w + 1.6, oy - 0.6, (w - 1.6) * 2.0, 4.6, edge)
    oval(ox - w + 1.6, oy + 1.5, 1.1, 1.4, cMain)
    oval(ox + w - 1.6, oy + 1.5, 1.1, 1.4, cMain)
    rect(ox - w + 1.6, oy + 0.1, (w - 1.6) * 2.0, 2.6, cMain)
    rect(ox - w + 1.6, oy - 0.2, (w - 1.6) * 2.0, 0.8, cTop)
  }
  // These immutable ramps are built once per material in a painting helper.
  scaleSteps(base: color) -> list<color> {
    return stepper(color.set.a(#000000, base.a) to base).pick(17)
  }
  tintSteps(base: color, target: color) -> list<color> {
    return stepper(base to color.set.a(target, base.a)).pick(17)
  }
  lightStep(tones: list<color>, position: f32) -> color {
    return tones[clamp(round(position * 16.0), 0, 16)]
  }

}
