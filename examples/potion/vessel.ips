// vessel.ips — the potion's glass body and its liquid.
// Paints absolute 64x64 coordinates; origin 0,0. The root passes a
// seed-rolled silhouette: `style` selects the family and top/bot/hw/
// topw/footw carry its proportions.
// Styles: 0 round, 1 capsule vial, 2 conical flask, 3 squat jar,
//         4 teardrop, 5 tall oval, 6 banded vial, 7 diamond,
//         8 double bulb / gourd, 9 box bottle, 10 amphora,
//         11 jug with spout, 12 handled bottle, 13 sphere on foot,
//         14 prism, 15 inverted teardrop.
//
// The vessel also fits the root's glass decoration and tied neck seal to
// the silhouette and reports them through its outputs:
//   label    — decoration centre, inside the glass
//   labelfit — x: scale (<= 1) at which the decoration fits there,
//              y: inner half-width of the glass across its rows
//   charm    — seal centre, resting against the shoulder
//
// The body is filled pixel by pixel from a signed distance to the chosen
// silhouette, because every pixel's tone depends on where it sits in the
// glass. That costs more fuel than painting rows, so it stays inside a
// 40x46 box and the details on top are drawn as rows, lines and ovals.

import mats from "materials.ips"

asset Vessel {
  size 64x64
  origin 0, 0

  input u32 style = 0
  input f32 cx = 32.0
  input f32 top = 30.0
  input f32 bot = 56.0
  input f32 hw = 13.0
  input f32 topw = 3.0
  input f32 footw = 3.0
  input f32 level = 38.0
  input color liquid = #ff0000
  input color glass = #2a4054
  input u32 frost = 0
  input u32 dew = 0
  input u32 drips = 0
  input u32 scratch = 0
  // decoration request: desired centre row, half extents, x jitter in -1..1
  input f32 labely = 40.0
  input f32 labelrx = 4.0
  input f32 labelry = 4.0
  input f32 labeljit = 0.0
  // seal request: desired centre row, half size, side (0 right, 1 left)
  input f32 charmy = 30.0
  input f32 charmr = 3.0
  input u32 charmside = 0

  output point label
  output point labelfit
  output point charm
  output mask interior

  const color frostFlake = #cfe8f8

  draw {
    liquid_ffffffTones = tintSteps(liquid, #ffffff)
    liquid_scaleTones = scaleSteps(liquid)
    glass_ffffffTones = tintSteps(glass, #ffffff)
    glass_scaleTones = scaleSteps(glass)
    outline = mats.Outline()
    ink = outline.base
    pewter = mats.Pewter()
    lLight = lightStep(liquid_ffffffTones, 0.30)
    lShade = lightStep(liquid_scaleTones, 0.70)
    lDeep = lightStep(liquid_scaleTones, 0.50)
    bounceTones = tintSteps(lShade, #ffffff)
    lBounce = lightStep(bounceTones, 0.18)
    lMeniscus = lightStep(liquid_ffffffTones, 0.65)
    gMain = lightStep(glass_ffffffTones, 0.16)
    gLit = lightStep(glass_ffffffTones, 0.30)
    gShade = lightStep(glass_scaleTones, 0.78)
    gRim = lightStep(glass_ffffffTones, 0.42)
    gInk = lightStep(glass_ffffffTones, 0.5)
    gDrop = lightStep(glass_ffffffTones, 0.55)
    spec = #f4fbff

    lLightGlints = tintSteps(lLight, spec)
    lShadeGlints = tintSteps(lShade, spec)
    lDeepGlints = tintSteps(lDeep, spec)
    lBounceGlints = tintSteps(lBounce, spec)
    lMeniscusGlints = tintSteps(lMeniscus, spec)
    liquidGlints = tintSteps(liquid, spec)
    gMainGlints = tintSteps(gMain, spec)
    gLitGlints = tintSteps(gLit, spec)
    gShadeGlints = tintSteps(gShade, spec)
    gRimGlints = tintSteps(gRim, spec)
    gMainFrost = tintSteps(gMain, #dff2ff)
    gLitFrost = tintSteps(gLit, #dff2ff)
    gShadeFrost = tintSteps(gShade, #dff2ff)
    gRimFrost = tintSteps(gRim, #dff2ff)

    midY = (top + bot) * 0.5
    halfH = max((bot - top) * 0.5, 1.0)
    // Second specular glint, a short bar right of the edge highlight.
    dotX = cx - hw * 0.30
    dotY = top + (bot - top) * 0.20

    // ---- body: silhouette, liquid and glass in crisp tone bands -------
    // `lit` is a cheap key-light term (upper left) from the position in
    // the silhouette; the 1px inner rim gets rim light or bounce light.
    layer bottle {
    for y in 14..60 {
      for x in 12..52 {
        px = float(x) + 0.5
        py = float(y) + 0.5
        d = shapeDistance(px, py, style, cx, top, bot, hw, topw, footw)
        if (d <= 0.8) {
          if (d > -1.3) {
            c = ink
          } else {
            nx = (px - cx) / hw
            ny = (py - midY) / halfH
            lit = -(nx * 0.80 + ny * 0.35)
            rim = d > -2.3
            if (py >= level) {
              depth = clamp((py - level) / (bot - level + 1.0), 0, 1)
              tone = lit - depth * 0.55
              if (tone > 0.38) { c = lLight; glints = lLightGlints }
              else if (tone > -0.22) { c = liquid; glints = liquidGlints }
              else if (tone > -0.62) { c = lShade; glints = lShadeGlints }
              else { c = lDeep; glints = lDeepGlints }
              if (rim && lit < -0.15) { c = lBounce; glints = lBounceGlints }
              if (py - level < 1.0) { c = lMeniscus; glints = lMeniscusGlints }
            } else {
              c = gMain; glints = gMainGlints; frostTones = gMainFrost
              if (lit > 0.25) { c = gLit; glints = gLitGlints; frostTones = gLitFrost }
              if (lit < -0.30) { c = gShade; glints = gShadeGlints; frostTones = gShadeFrost }
              if (rim && lit < -0.15) { c = gRim; glints = gRimGlints; frostTones = gRimFrost }
              if (frost == 1) {
                c = lightStep(frostTones, 0.38 * clamp((level - py) / (level - top + 1.0), 0.0, 1.0))
              }
            }
            // Edge highlight: a crisp band just inside the rim, upper left.
            if (d <= -2.3 && d > -3.4 && nx < -0.20 && ny > -0.92 && ny < 0.30) {
              c = lightStep(glints, 0.82)
            }
            if (abs(px - dotX) < 0.8 && abs(py - dotY) < 1.3 && d < -3.0) {
              c = lightStep(glints, 0.75)
            }
          }
          pixel(x, y, c)
        }
      }
    }

    }
    interior = mask.shrink(mask.from(bottle), 2)
    surface.paint(bottle)

    // ---- style accents ------------------------------------------------
    if (style == 1) {
      ty = (top + bot) / 2.0
      rect(cx + hw * 0.35, ty - 3.0, hw * 0.5, 0.8, gInk)
      rect(cx + hw * 0.35, ty, hw * 0.5, 0.8, gInk)
    }
    if (style == 2) {
      h2 = bot - top
      t1 = top + h2 * 0.55
      w1 = topw + (hw - topw) * 0.55
      rect(cx + w1 * 0.35, t1, w1 * 0.5, 0.8, gInk)
      t2 = top + h2 * 0.70
      w2 = topw + (hw - topw) * 0.70
      rect(cx + w2 * 0.35, t2, w2 * 0.5, 0.8, gInk)
      t3 = top + h2 * 0.85
      w3 = topw + (hw - topw) * 0.85
      rect(cx + w3 * 0.35, t3, w3 * 0.5, 0.8, gInk)
    }
    if (style == 6) {
      h3 = bot - top
      band(cx, top + h3 * 0.40, hw, 1.6, pewter)
      band(cx, top + h3 * 0.52, hw, 1.6, pewter)
      band(cx, top + h3 * 0.64, hw, 1.4, pewter)
    }
    if (style == 11) {
      // jug spout
      h4 = bot - top
      ax = cx + hw * 0.60
      ay = top + h4 * 0.26
      tx = cx + hw * 1.28
      ty2 = top - h4 * 0.10
      poly(ink, ax - 1.2, ay + 3.0, tx - 1.0, ty2 + 1.2, tx + 0.8, ty2 - 1.2, ax + 1.2, ay - 3.0)
      poly(gRim, ax - 0.2, ay + 1.9, tx - 0.3, ty2 + 0.4, tx + 0.4, ty2 - 0.6, ax + 0.4, ay - 1.9)
      oval(tx, ty2, 1.0, 1.3, ink)
    }
    if (style == 12) {
      // side handle
      h5 = bot - top
      curve({cx + hw * 0.85, top + h5 * 0.14}, {cx + hw * 1.62, top + h5 * 0.48},
            {cx + hw * 0.80, top + h5 * 0.80}, 3.0, ink)
      curve({cx + hw * 0.85, top + h5 * 0.14}, {cx + hw * 1.54, top + h5 * 0.48},
            {cx + hw * 0.80, top + h5 * 0.80}, 1.7, gRim)
    }
    if (style == 13) {
      // foot plate
      fw = max(topw, 1.8)
      oval(cx, bot - 0.8, fw + 1.6, 1.6, ink)
      oval(cx, bot - 0.9, fw + 0.8, 1.0, gInk)
    }
    if (style == 14) {
      // prism facets
      fx = min(hw * 0.42, min(topw, footw) - 1.0)
      line(cx - fx, top + 1.5, cx - fx, bot - 1.5, 1, gRim)
      line(cx, top + 1.5, cx, bot - 1.5, 1, gShade)
    }

    // ---- bubbles in the liquid (seed-varied) --------------------------
    bobCount = 1 to 3
    for i in 0..bobCount {
      bx = 19 to 44
      by = int(level) + (3 to 12)
      if (shapeDistance(float(bx) + 0.5, float(by) + 0.5, style, cx, top, bot, hw, topw, footw) < -3.0) {
        pixel(bx, by, lMeniscus)
        if (chance(0.5)) {
          pixel(bx + 1, by + 1, lLight)
          pixel(bx, by - 1, lLight)
        }
      }
    }

    // ---- glass wear and weather (seed-varied) -------------------------
    if (dew == 1) {
      dropCount = 2 to 4
      for i in 0..dropCount {
        dx = cx + (-1.0 to 1.0) * hw * 0.7
        dy = top + 2.0 to top + 2.0 + max(level - top - 6.0, 2.0)
        if (shapeDistance(dx, dy, style, cx, top, bot, hw, topw, footw) < -2.6) {
          rect(float(int(dx)), float(int(dy)), 1.0, 2.0, gDrop)
          pixel(int(dx), int(dy), spec)
        }
      }
    }
    if (drips == 1) {
      dripCount = 1 to 2
      for i in 0..dripCount {
        dx = cx + (-1.0 to 1.0) * max(topw, 1.5)
        dlen = 3.0 to 8.0
        line(dx, top + 0.5, dx, top + dlen, 1, gRim)
        rect(float(int(dx)), top + dlen, 1.0, 1.6, gDrop)
      }
    }
    if (scratch == 1) {
      // Short straight scratches, slanted like "/", fully inside the glass.
      scCount = 1 to 2
      for i in 0..scCount {
        ax = cx + (-1.0 to 1.0) * hw * 0.5
        ay = top + 4.0 to top + 4.0 + max(bot - top - 10.0, 2.0)
        len = 2.5 to 4.5
        sxe = ax + len * 0.7
        sye = ay - len * 0.7
        if (shapeDistance(ax, ay, style, cx, top, bot, hw, topw, footw) < -2.6) {
          if (shapeDistance(sxe, sye, style, cx, top, bot, hw, topw, footw) < -2.6) {
            line(ax, ay, sxe, sye, 1, lightStep(gMainGlints, 0.55))
          }
        }
      }
    }
    if (frost == 1) {
      flakeCount = 2 to 4
      for i in 0..flakeCount {
        fx = cx + (-1.0 to 1.0) * hw * 0.72
        fy = top + 1.5 to top + 1.5 + max(level - top - 5.0, 2.0)
        if (shapeDistance(fx, fy, style, cx, top, bot, hw, topw, footw) < -2.6) {
          pixel(int(fx), int(fy), spec)
          pixel(int(fx) - 1, int(fy), frostFlake)
          pixel(int(fx) + 1, int(fy), frostFlake)
          pixel(int(fx), int(fy) - 1, frostFlake)
          pixel(int(fx), int(fy) + 1, frostFlake)
        }
      }
    }

    // ---- fit the decoration inside the glass --------------------------
    // Try rows outward from the requested one (0, +2, -2, +4, ...) and take
    // the first where the whole box fits; otherwise shrink it on the
    // widest row found.
    edgeIn = -2.0
    yLo = top + labelry + 1.0
    yHi = max(bot - labelry - 1.0, yLo)
    fitY = -1.0
    fitW = 0.0
    bestY = clamp(labely, yLo, yHi)
    bestW = -1.0
    k = 0
    while (k < 15 && fitY < 0.0) {
      off = float((k + 1) / 2) * 2.0
      if (k % 2 == 0) { off = -off }
      yc = clamp(labely + off, yLo, yHi)
      wc = spanMin(yc, labelry, edgeIn, style, cx, top, bot, hw, topw, footw)
      if (wc >= labelrx) { fitY = yc; fitW = wc }
      if (wc > bestW) { bestY = yc; bestW = wc }
      k = k + 1
    }
    scale = 1.0
    if (fitY < 0.0) {
      fitY = bestY
      fitW = max(bestW, 0.0)
      scale = fitW / max(labelrx, 0.1)
    }
    label = {cx + labeljit * max(fitW - labelrx * scale, 0.0), fitY}
    labelfit = {scale, fitW}

    // ---- fit the neck seal against the shoulder -----------------------
    chy = clamp(charmy, charmr + 2.0, 61.0 - charmr)
    outW = spanMax(chy, charmr, 0.8, style, cx, top, bot, hw, topw, footw)
    side = 1.0
    if (charmside == 1) { side = -1.0 }
    // Rest on the near face rather than dangling outside the bottle outline.
    chx = clamp(cx + side * max(charmr + 0.5, outW * 0.48), charmr + 1.0, 63.0 - charmr)
    charm = {chx, chy}
  }

  // Metal band across the vial, clipped to the outline by the caller's width.
  band(ox: f32, oy: f32, w: f32, h: f32, m: mats.Pewter) {
    rect(ox - w - 0.4, oy, w * 2.0 + 0.8, h, m.shadow)
    rect(ox - w - 0.4, oy, w * 2.0 + 0.8, h * 0.45, color.mix(m.base, m.light, 0.5))
  }

  // Signed distance for the selected silhouette. Values near zero follow
  // the boundary; the shading in draw() only needs a monotone field.
  // For styles 8/10/13/14/15 some of ot/of carry varied roles:
  //   8  `ot`   top bulb radius
  //   10 `ot`   top width, `of` foot width, shoulder at 32% height
  //   13 `ot`   foot stem half width
  //   14 `ot`   top width, `of` foot width, shoulder at mid height
  //   15 `ot`   bottom tip width
  shapeDistance(px: f32, py: f32, st: i32, ox: f32, y0: f32, y1: f32, ow: f32, ot: f32, of: f32) -> f32 {
    if (st == 0 || st == 12) { return dist.circle({px, py}, {ox, y0 + ow}, ow) }
    if (st == 1 || st == 6) { return dist.roundrect({px, py}, {ox, (y0 + y1) / 2.0}, {ow, (y1 - y0) / 2.0}, ow) }
    if (st == 3 || st == 11) { return dist.roundrect({px, py}, {ox, (y0 + y1) / 2.0}, {ow, (y1 - y0) / 2.0}, 5.0) }
    if (st == 9) { return dist.roundrect({px, py}, {ox, (y0 + y1) / 2.0}, {ow, (y1 - y0) / 2.0}, 2.5) }
    if (st == 5) { return (vec2.len({(px - ox) / ow, (py - (y0 + y1) / 2.0) / ((y1 - y0) / 2.0)}) - 1.0) * min(ow, (y1 - y0) / 2.0) }
    if (st == 7) {
      dy = py - (y0 + y1) / 2.0
      rh = (y1 - y0) / 2.0
      return ((abs(px - ox) / ow + abs(dy) / rh) - 1.0) * min(ow, rh) * 0.7
    }
    if (st == 8) {
      dB = dist.circle({px, py}, {ox, y1 - ow}, ow)
      dT = dist.circle({px, py}, {ox, y0 + ot}, ot)
      return min(dB, dT)
    }
    if (st == 10) {
      t = clamp((py - y0) / (y1 - y0), 0, 1)
      if (t < 0.32) { w = ot + (ow - ot) * (t / 0.32) }
      else { w = ow + (of - ow) * ((t - 0.32) / 0.68) }
      return max3(abs(px - ox) - w, y0 - py, py - y1)
    }
    if (st == 13) {
      d1 = dist.circle({px, py}, {ox, y0 + ow}, ow)
      d2 = max3(abs(px - ox) - max(ot, 1.8), y0 + ow * 2.0 - 1.0 - py, py - y1)
      return min(d1, d2)
    }
    if (st == 14) {
      t2 = clamp((py - y0) / (y1 - y0), 0, 1)
      if (t2 < 0.5) { w2 = ot + (ow - ot) * (t2 / 0.5) }
      else { w2 = ow + (of - ow) * ((t2 - 0.5) / 0.5) }
      return max3(abs(px - ox) - w2, y0 - py, py - y1)
    }
    if (st == 15) {
      // Union of the top circle and the taper below its centre; a plain
      // switch at cy2 would leave a near-zero seam across the body.
      cy2 = y0 + ow
      t3 = clamp((y1 - py) / (y1 - cy2), 0, 1)
      w3 = ot + (ow - ot) * t3
      return min(dist.circle({px, py}, {ox, cy2}, ow), max3(abs(px - ox) - w3, py - y1, cy2 - py))
    }
    if (st == 2) {
      tc = clamp((py - y0) / (y1 - y0), 0, 1)
      wc = ot + (ow - ot) * tc
      return max3(abs(px - ox) - wc, y0 - py, py - y1)
    }
    // st == 4, teardrop: round lower part united with a linear taper above
    // its centre.
    cy = y1 - ow
    t2 = clamp((py - y0) / (cy - y0), 0, 1)
    return min(dist.circle({px, py}, {ox, cy}, ow), max3(abs(px - ox) - (ot + (ow - ot) * t2), y0 - py, py - cy))
  }

  // Half-width of the silhouette row at `py`, measured where the distance
  // reaches `edge`. Every style is a single symmetric run per row and the
  // distance grows with |x - ox|, so a bisection finds the boundary.
  rowHalf(py: f32, edge: f32, st: i32, ox: f32, y0: f32, y1: f32, ow: f32, ot: f32, of: f32) -> f32 {
    if (shapeDistance(ox, py, st, ox, y0, y1, ow, ot, of) > edge) { return 0.0 }
    lo = 0.0
    hi = max(ow, ot) + 2.0
    for i in 0..8 {
      m = (lo + hi) * 0.5
      if (shapeDistance(ox + m, py, st, ox, y0, y1, ow, ot, of) <= edge) { lo = m } else { hi = m }
    }
    return lo
  }

  // Narrowest row half-width over [yc - ry, yc + ry], sampled at five rows.
  spanMin(yc: f32, ry: f32, edge: f32, st: i32, ox: f32, y0: f32, y1: f32, ow: f32, ot: f32, of: f32) -> f32 {
    r = rowHalf(yc, edge, st, ox, y0, y1, ow, ot, of)
    r = min(r, rowHalf(yc - ry, edge, st, ox, y0, y1, ow, ot, of))
    r = min(r, rowHalf(yc + ry, edge, st, ox, y0, y1, ow, ot, of))
    r = min(r, rowHalf(yc - ry * 0.5, edge, st, ox, y0, y1, ow, ot, of))
    return min(r, rowHalf(yc + ry * 0.5, edge, st, ox, y0, y1, ow, ot, of))
  }

  // Widest row half-width over [yc - ry, yc + ry], sampled at five rows.
  spanMax(yc: f32, ry: f32, edge: f32, st: i32, ox: f32, y0: f32, y1: f32, ow: f32, ot: f32, of: f32) -> f32 {
    r = rowHalf(yc, edge, st, ox, y0, y1, ow, ot, of)
    r = max(r, rowHalf(yc - ry, edge, st, ox, y0, y1, ow, ot, of))
    r = max(r, rowHalf(yc + ry, edge, st, ox, y0, y1, ow, ot, of))
    r = max(r, rowHalf(yc - ry * 0.5, edge, st, ox, y0, y1, ow, ot, of))
    return max(r, rowHalf(yc + ry * 0.5, edge, st, ox, y0, y1, ow, ot, of))
  }

  max3(a: f32, b: f32, c: f32) -> f32 { return max(max(a, b), c) }
  // These immutable ramps are built once per material in a painting helper.
  scaleSteps(base: color) -> list<color> {
    return stepper(color.set.a(#000000, base.a) to base).pick(17)
  }
  tintSteps(base: color, target: color) -> list<color> {
    return stepper(base to color.set.a(target, base.a)).pick(17)
  }
  lightStep(tones: list<color>, position: f32) -> color {
    return tones[clamp(round(position * 16.0), 0, 16)]
  }

}
