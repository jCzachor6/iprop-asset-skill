// wing.ips: one side of a butterfly seen from above: the hindwing, the
// forewing that overlaps it, their shadows and the antenna.
//
// The root draws this part twice with one seed, the second time with
// mirror_x, so both sides match to the pixel, and then body.ips once over
// both. Local x = 0 is the body axis (root x = 128). Everything is rolled here from the seed: the silhouette
// first, in its own stream, then the colours and the pattern of the style.
//
// Each wing is a closed Catmull-Rom outline of 96 points. Its colour field is
// painted as outlines scaled about the wing root, so bands, borders and the
// basal gradient follow the wing's own shape. Spots, eyespots, stripes, veins
// and scale texture are positioned by outline index (between the veins) and
// by the fraction f of the way from the root to the margin.
//
// Styles: 1 monarch, 2 swallowtail, 3 morpho, 4 white or sulphur, 5 peacock,
// 6 admiral, 7 longwing, 8 fritillary, 9 blue, 10 emerald, 11 glasswing,
// 12 satyr, 13 copper. A colour scheme recolours the style, often into
// colours no real butterfly wears, and an abstract motif may go over it.

import scales from "scales.ips"

asset ButterflyWing {
  size 128x256
  origin 0,0
  // 0 rolls the style or scheme from a hash of the seed, so a rolled one
  // renders exactly like the same one chosen explicitly. Every program that
  // calls this part with one seed resolves the same pair.
  input u32 style = 0
  input color tint = #00000000
  input u32 shadow = 1
  // Colour scheme over the style: 1 natural, 2 pastel, 3 neon, 4 dark,
  // 5 light, 6 magic, 7 aberrant (the style's colours turned to a new hue),
  // and the fantasy schemes: 8 gradient (a designed three-colour gradient),
  // 9 duo (forewing and hindwing in two hues), 10 nebula (night clouds and
  // stars), 11 opal, 12 flame, 13 frost, 14 prism (rainbow rings).
  input u32 scheme = 0
  // An abstract motif over the pattern: 1 none, 2 ripples, 3 marble,
  // 4 filigree (glowing veins and lace), 5 stardust, 6 orbs, 7 sunburst,
  // 8 shimmer (a holographic sheen), 9 pearls. 0 rolls one, like the scheme.
  input u32 motif = 0
  // 1 writes the outputs; the root's mirrored call passes 0, so the host
  // keeps the right side's values.
  input u32 report = 1
  // 0 paints both wings (the single-program butterfly.ips); 1 only the
  // forewing and the antenna, 2 only the hindwing with every ground shadow.
  // 1 and 2 are separate programs composed by the host.
  input u32 which = 0
  // 1 spends a separate program's whole budget: finer gradients, a stronger
  // blur and denser scale texture.
  input u32 detail = 0

  // For the root: the wing root on the body axis, the outer top corner of the
  // drawing and its lowest point. The body part's data travels in points as
  // well, the second value in y: span {fore, hind} wing lengths, build
  // {thorax, abdomen} proportions, and the colour scheme for the body:
  // shift {hue, saturation}, level {value, lift} and dusk {sink, motif};
  // design {style, scheme} as resolved.
  output point wingRoot
  output point extent
  output point foot
  output point span
  output point build
  output point shift
  output point level
  output point dusk
  output point design

  // Per style (index style - 1): the wing's ground colour, its dark rim and
  // two accents (bands, spots, eyespot rings).
  palette grounds = [#c4520a to #f29a2a, #e6c445 to #f8eaa4, #1a44c8 to #3cacff,
                     #ece6d6 to #fffaee, #8e2014 to #c84a1e, #1c1612 to #3a2c24,
                     #140e0e to #2a2020, #c06a20 to #eaa452, #4c68d6 to #a2b8ff,
                     #0e1612 to #1e2c26, #dce4e2 to #f4f8f4, #4a3424 to #8c6a46,
                     #d0501a to #f28c30]
  palette rims = [#0e0a08 to #1e1612, #0e0c0a to #1e1a14, #08091a to #1a1a28,
                  #1c1c1c to #3e3a36, #2a1610 to #4a2c20, #0e0a08 to #1a1410,
                  #0a0808 to #141010, #2a1608 to #4a2a12, #181828 to #36364c,
                  #080c0a to #121a14, #1e1410 to #3a2418, #2a1c12 to #4a3424,
                  #1a0e08 to #3a1e10]
  palette accents = [#f4f0e4 to #fffef8, #0e1014 to #1e1e24, #eef2ff to #ffffff,
                     #141414 to #2a2a2a, #e8b830 to #f8dc70, #d83a14 to #fa7024,
                     #d02418 to #f25420, #1a1008 to #2e1c0c, #f4f4f4 to #ffffff,
                     #2ac078 to #66f2b4, #f4f0e8 to #ffffff, #e2b852 to #f4d88a,
                     #1a0e08 to #2c1a0e]
  palette accents2 = [#f2a030 to #f8c060, #3a6ae8 to #7aa8ff, #f4f4ff to #ffffff,
                      #f07818 to #f8a040, #2a5ac8 to #6a9aff, #f4f4f0 to #ffffff,
                      #f2d02a to #fae878, #f0e2b0 to #faf2d6, #f2a030 to #f8c870,
                      #c8a838 to #f0d468, #f08a30 to #f8b060, #f4f2ec to #ffffff,
                      #f28030 to #f8a850]
  palette hairs = [#1a1210 to #3a2a20, #1a1810 to #3a3220, #2a2018 to #5a4434,
                   #8a8478 to #c8c2b2, #3a2418 to #6a4430, #2a201a to #4a3a2e,
                   #120e0e to #2a2222, #6a5034 to #a8865c, #6a7088 to #a8b0c8,
                   #141a16 to #2c3a30, #3a2a20 to #6a5040, #4a3828 to #7a6048,
                   #4a2a18 to #7a4a2a]
  palette sulphurs = [#f4dc54 to #fcee98, #e8f0c8 to #f6faea, #f4c858 to #fce6a0]
  palette wingShades = [#000000, #1a1008, #ffffff]
  // The gradient scheme's designed gradients (index aligned): the colour by
  // the body, the middle one and the margin's, and the accents' hue in turns.
  palette dawnDeep = [#3a0a4a to #4a1260, #071a3a to #0c2a4a, #5a1a3a to #6a2448,
                      #4a3a8a to #5e4ca0, #1a5a34 to #246a40, #4a0a34 to #5e1242,
                      #10164a to #1a205e, #0a3e40 to #10504e, #240606 to #340a0a,
                      #0a2060 to #10307a, #263418 to #34441e, #2a0a4a to #3a1060,
                      #f06a50 to #ff8064, #3a2a6a to #4a3880, #0a2a5a to #10366e,
                      #4a1a2a to #5a2436]
  palette dawnMid = [#e0457b to #f0608e, #18b59a to #2ad0b0, #ff9ec4 to #ffb4d2,
                     #f290b8 to #f8a8c8, #a8d838 to #c0ea50, #f0306e to #ff4a84,
                     #6a48f0 to #8060ff, #34d8a8 to #50e8bc, #d83818 to #f05024,
                     #9038d8 to #a850ec, #c09464 to #d0a878, #20a8f0 to #40c0ff,
                     #ffd36a to #ffe08a, #b48ae8 to #c4a0f4, #ff8a3a to #ff9e54,
                     #e88a8a to #f09c9c]
  palette dawnEdge = [#ffc46b to #ffd88a, #b4f0ff to #d8faff, #fff0f6 to #fffafc,
                      #ffe0c0 to #fff0dc, #fff070 to #fff8a0, #ffc860 to #ffd880,
                      #ff98d0 to #ffb0dc, #f8e49a to #fff0b8, #ffd060 to #ffe088,
                      #ff6898 to #ff84ac, #ffcad8 to #ffdce6, #f8f0ff to #ffffff,
                      #a8f0c0 to #c0ffd4, #ffd890 to #ffe4ac, #ffe0a0 to #fff0c4,
                      #ffe2c0 to #fff0dc]
  const list<f32> dawnAccent = [0.5, 0.86, 0.33, 0.45, 0.9, 0.5, 0.14, 0.95, 0.55, 0.15,
                                0.36, 0.88, 0.6, 0.08, 0.55, 0.45]

  const distribution styleMix = weighted {1: 9, 2: 9, 3: 8, 4: 9, 5: 7, 6: 8, 7: 7,
                                          8: 8, 9: 7, 10: 6, 11: 4, 12: 8, 13: 6}
  const distribution schemeMix = weighted {1: 10, 2: 8, 3: 8, 4: 6, 5: 6, 6: 9, 7: 5, 8: 14,
                                           9: 8, 10: 7, 11: 7, 12: 5, 13: 5, 14: 7}
  const distribution motifMix = weighted {1: 22, 2: 10, 3: 10, 4: 10, 5: 10, 6: 9, 7: 9, 8: 10, 9: 10}
  const distribution typical = gaussian(mean=0.5, sigma=0.18)
  const sampler<f32> wobble = sampler(-1.0 to 1.0 with gaussian(0.0, 0.5))
  // Margin ends of the main veins and the gaps between them (outline index).
  const list<f32> foreGaps = [25.5, 28.5, 32.0, 37.0, 43.0, 48.5, 53.5, 59.0]
  const list<f32> hindGaps = [22.5, 29.5, 35.0, 41.0, 46.5, 51.5, 58.0]

  // Stream keys, one per purpose: hash(seed ^ key) seeds that purpose's stream.
  // Keep them fixed once a game stores seeds.
  const i32 styleKey = 0x2f6b9a13
  const i32 schemeKey = 0x4f1bbcdd
  const i32 motifKey = 0x1b03738b
  const i32 hairKey = 0x6c62272e        // body.ips rolls the same hair from the same key and seed
  const i32 shapeKey = 0x51ed2701
  const i32 colorKey = 0x2545f491
  const i32 detailKey = 0x3c6ef372
  // Every painted detail XORs a key of its own onto the detail seed, one per
  // wing. The soft and the sharp pass of a motif share its key: they draw the
  // same motif.
  const i32 hindFieldKey = 0x0b4f2a91
  const i32 foreFieldKey = 0x3e5c7d19
  const i32 hindDetailKey = 0x1b873593
  const i32 foreDetailKey = 0x2c1b3c6d
  const i32 hindMottleKey = 0x0e4f1a77
  const i32 foreMottleKey = 0x61c88647
  const i32 hindFlameKey = 0x6b43a9b5
  const i32 foreFlameKey = 0x2f1e8c3d
  const i32 hindSpotKey = 0x5bd1e995
  const i32 foreSpotKey = 0x1b56c4e9
  const i32 hindMotifKey = 0x5851f42d
  const i32 foreMotifKey = 0x14057b7e
  const i32 stripeKey = 0x297a2d39
  const i32 scaleKey = 0x5f356495
  const i32 hindRowKey = 0x3a2f9c15
  const i32 foreRowKey = 0x7b1d4e83
  const i32 hindGlintKey = 0x2d7f9a41
  const i32 foreGlintKey = 0x7c3b2e19
  const i32 hindGrainKey = 0x68e31da4
  const i32 foreGrainKey = 0x4cf5ad43
  const i32 hindHairKey = 0x7feb352d
  const i32 foreHairKey = 0x6a09e667
  const i32 innerHairKey = 0x1f83d9ab

  draw {
    look = clamp(int(style), 1, 13)
    if (style == 0) {
      stream_push(hash(seed ^ styleKey))
      look = 1 to 13 with styleMix
      stream_pop()
    }
    rolledScheme = clamp(int(scheme), 1, 14)
    if (scheme == 0) {
      stream_push(hash(seed ^ schemeKey))
      rolledScheme = 1 to 14 with schemeMix
      stream_pop()
    }
    rolledMotif = clamp(int(motif), 1, 9)
    if (motif == 0) {
      stream_push(hash(seed ^ motifKey))
      rolledMotif = 1 to 9 with motifMix
      stream_pop()
    }
    // The hair colour is shared with body.ips, which hashes the same seed.
    stream_push(hash(seed ^ hairKey))
    hair = hairs[look - 1].pick()
    stream_pop()

    // ---- silhouette: its own stream, so colours never move it ------------
    stream_push(hash(seed ^ shapeKey))
    size = 0.80 to 1.0 with beta(2.2, 1.3)
    foreAngle = 22.0 to 52.0 with gaussian(37.0, 6.0)
    tornusAngle = -14.0 to 24.0 with gaussian(6.0, 7.0)
    tornusDist = 0.56 to 0.80 with gaussian(0.68, 0.05)
    costaBulge = 0.0 to 0.06 with gaussian(0.025, 0.015)
    hook = 0.0
    if (chance(0.15)) { hook = 0.02 to 0.09 }
    convex = -0.05 to 0.12 with gaussian(0.04, 0.04)
    innerBulge = -0.03 to 0.06 with gaussian(0.02, 0.02)
    apexRound = 0.0 to 0.10 with beta(2.0, 2.0, 0.0, 0.10)
    hindRatio = 0.56 to 0.86 with gaussian(0.70, 0.06)
    hindTurn = -16.0 to 12.0 with gaussian(-2.0, 6.0)
    hindWide = 0.82 to 1.18 with gaussian(1.0, 0.08)
    hindTall = 0.80 to 1.25 with gaussian(1.0, 0.09)
    hindLobe = -0.10 to 0.22 with gaussian(0.04, 0.07)
    jit = wobble.pick(16)
    scallop = 0.0
    if (chance(0.4)) { scallop = 0.01 to 0.05 }
    scallopCount = float(5 to 9)
    foreScallop = 0.0
    if (chance(0.08)) { foreScallop = 0.008 to 0.025 }
    tailRoll = 0.15 to 0.45
    tailChance = 0.0 to 1.0
    tailAt = 46.0 to 51.0
    tailBend = -1.05 to -0.55
    thorax = 0.11 to 0.16
    abdomen = 0.62 to 0.86 with gaussian(0.74, 0.06)
    antenna = 0.38 to 0.62 with gaussian(0.5, 0.06)
    antennaAngle = 55.0 to 80.0
    stream_pop()

    // Styles bend the rolled silhouette, without new draws: swallowtails
    // carry tails, longwings have narrow forewings, blues stay small.
    tail = 0.0
    if (tailChance < 0.12 || (look == 2 && tailChance < 0.85) || (look == 10 && tailChance < 0.5)) {
      tail = tailRoll
    }
    if (look == 7) {
      tornusDist = tornusDist * 0.78
      hindRatio = hindRatio * 0.86
      hindTall = hindTall * 0.88
    }
    if (look == 9 || look == 13) { size = size * 0.86 }
    if (look == 3 || look == 10) { size = min(1.0, size * 1.06) }

    // ---- outline keys in units of the wing length --------------------------
    fe = dir(foreAngle)
    fw = {-fe.y, fe.x}
    apex = fe
    torn = dir(-tornusAngle) * tornusDist
    edge = torn - apex
    out = vec2.normalize({edge.y, -edge.x})
    if (vec2.dot(out, apex) < 0.0) { out = -out }
    inner = vec2.normalize({torn.y, -torn.x})
    if (inner.y < 0.0) { inner = -inner }
    foreUnit = [
      {0.0, 0.0},
      fe * 0.5 - fw * costaBulge,
      fe * (1.0 - apexRound) + fw * (apexRound * 0.4),
      apex + edge * 0.26 + out * (convex * 0.6 - hook),
      apex + edge * 0.64 + out * convex,
      torn,
      torn * 0.5 + inner * innerBulge,
      fe * 0.04 + fw * 0.08,
    ]
    hindUnit = [
      {0.0, 0.0},
      hindKey({0.40, -0.16}, hindTurn, hindWide, hindTall, {jit[2], jit[3]} * 0.03),
      hindKey({0.80, -0.06}, hindTurn, hindWide, hindTall, {jit[4], jit[5]} * 0.04),
      hindKey({0.98, 0.30}, hindTurn, hindWide, hindTall, {jit[6], jit[7]} * 0.04),
      hindKey({0.80, 0.68}, hindTurn, hindWide, hindTall, {jit[8], jit[9]} * 0.04),
      hindKey({0.42, 0.95 + hindLobe}, hindTurn, hindWide, hindTall, {jit[10], jit[11]} * 0.04),
      hindKey({0.10, 0.62}, hindTurn, hindWide, hindTall, {jit[12], jit[13]} * 0.02),
      hindKey({0.03, 0.18}, hindTurn, hindWide, hindTall, {0.0, 0.0}),
    ]

    // ---- fit both wings, the tail, the body and the antenna -----------------
    gap = 0.035
    rootX = 2.5
    fMinY = 0.0
    fMaxX = 0.0
    hMaxY = 0.0
    hMaxX = 0.0
    for i in 0..8 {
      fMinY = min(fMinY, foreUnit[i].y)
      fMaxX = max(fMaxX, foreUnit[i].x)
      hMaxY = max(hMaxY, hindUnit[i].y)
      hMaxX = max(hMaxX, hindUnit[i].x)
    }
    antTop = thorax + 0.09 + antenna * sin(antennaAngle * 0.0174533)
    top = max(-fMinY * 1.04, antTop) + gap
    bottom = max(hindRatio * (hMaxY * 1.04 + tail * 0.8), thorax * 0.75 + abdomen * hindRatio) + gap
    widthUnit = max(fMaxX * 1.04, hindRatio * (hMaxX * 1.06 + tail * 0.3))
    fore = min((121.0 - rootX) / widthUnit, 244.0 / (top + bottom)) * size
    hind = fore * hindRatio
    rootY = 128.0 + (top - bottom) * fore * 0.5
    fr = {rootX, rootY - gap * fore}
    hr = {rootX, rootY + gap * fore}
    if (report == 1) {
      wingRoot = {0.0, rootY}
      extent = {rootX + widthUnit * fore, rootY - top * fore}
      foot = {0.0, rootY + bottom * fore}
      span = {fore, hind}
      build = {thorax, abdomen}
    }

    fk = placed(foreUnit, fr, fore)
    hk = placed(hindUnit, hr, hind)
    foreLine = outline(fk, [0.25, 0.625, foreScallop * fore, scallopCount])
    hindLine = outline(hk, [0.25, 0.75, scallop * hind, scallopCount])
    tailBase = at(hindLine, hr, tailAt, 0.92)
    tailDir = vec2.rot(vec2.normalize(tailBase - hr), tailBend)
    tailTip = tailBase + tailDir * (tail * hind)
    tailWidth = hind * (0.065 to 0.095)

    // ---- colour and pattern: a stream of their own --------------------------
    stream_push(hash(seed ^ colorKey))
    ground = grounds[look - 1].pick()
    sulphur = sulphurs[index(3)].pick()
    if (look == 4 && chance(0.45)) { ground = sulphur }
    if (tint.a != 0) { ground = color.mix(tint, ground, 0.12) }
    rim = rims[look - 1].pick()
    accent = accents[look - 1].pick()
    accent2 = accents2[look - 1].pick()
    // The ground deepens towards the body; the outer field may warm or cool.
    deep = color.mix(ground, hair, 0.25 to 0.55 with typical)
    outer = color.shade(ground, -4 to 10)
    hindGround = color.mix(ground, color.shade(ground, -18), 0.0 to 0.5 with beta(1.5, 3.0))
    deepHind = color.mix(hindGround, hair, 0.30 to 0.60 with typical)

    // Defaults: plain wing, thin dark veins, a light hairy base.
    foreRim = 0.0 to 0.05 with beta(1.5, 3.0, 0.0, 0.05)
    hindRim = foreRim
    rimStroke = 0.0
    veinWidth = fore * (0.008 to 0.014)
    veinColor = color.set.a(color.mix(rim, deep, 0.3), 120 to 190)
    basalF = 0.20 to 0.34
    basalAmount = 0.35 to 0.75 with typical
    bandColor = accent
    bandLo = 2.0
    bandHi = 2.0
    hindBandLo = 2.0
    hindBandHi = 2.0
    hindBandColor = accent2
    marginRows = 0
    marginColor = accent
    marginSize = fore * (0.022 to 0.034)
    apexPatch = 0.0
    apexColor = rim
    subapical = 0
    subapicalColor = accent
    foreEyes = 0
    hindEyes = 0
    eyeSize = fore * (0.045 to 0.075)
    eyeRing = accent
    eyePupil = accent2
    stripes = 0
    stripeColor = accent
    diag = 0
    diagColor = accent
    diagWidth = fore * (0.10 to 0.17)
    diagCosta = 13.0 to 18.0
    diagEnd = 54.0 to 64.0
    diagBow = 0.52 to 0.70
    hindDiag = 0
    spotRows = 0
    spotColor = rim
    discal = 0
    sheen = 0.0
    sheenColor = color.shade(ground, 40)
    glass = 0
    rays = 0
    rayColor = accent2
    analEye = 0
    blueRow = 0
    lines = 0
    mottle = 0.15 to 0.45
    texture = 0.5 to 1.0
    fringeLight = color.mix(ground, #f4f0e6, 0.5 to 0.9)
    fringeDark = color.mix(rim, ground, 0.0 to 0.3)
    checker = chance(0.5)
    antennaTip = color.shade(hair, 30 to 70)

    // Every style reads the same rolls, so forcing a style never moves them.
    rollA = 0.0 to 1.0
    rollB = 0.0 to 1.0
    rollC = 0.0 to 1.0
    variety = 0.0 to 1.0
    gloss = 0.10 to 0.22
    // The scheme's rolls, drawn whatever the scheme.
    hueSpin = 0.0 to 1.0
    hueSpread = 0.12 to 0.45
    accentTurn = pick(0.5, 0.33, 0.67, 0.0)
    schemeDepth = 0.0 to 1.0 with beta(2.0, 2.0)
    if (look == 1) {
      // Monarch, queen or viceroy: black veins, black rim with white dots.
      foreRim = 0.10 to 0.15
      hindRim = foreRim * (0.9 to 1.2)
      veinWidth = fore * (0.014 to 0.024)
      if (rollA < 0.25) { veinWidth = veinWidth * 0.55 }
      veinColor = rim
      marginRows = 2
      marginSize = fore * (0.018 to 0.026)
      apexPatch = 0.30 to 0.42
      subapical = 1
      subapicalColor = color.mix(accent, accent2, 0.0 to 0.7 with beta(1.0, 3.0))
      if (rollB < 0.3) { lines = 1 }
      deep = color.mix(ground, hair, 0.10 to 0.30)
      checker = 1
    } else if (look == 2) {
      // Swallowtail: tiger stripes, dark base, yellow lunules, blue haze.
      foreRim = 0.16 to 0.24
      hindRim = 0.22 to 0.32
      stripes = 3 to 5
      stripeColor = rim
      deep = color.mix(rim, ground, 0.0 to 0.35)
      basalF = 0.26 to 0.40
      basalAmount = 0.85 to 1.0
      marginRows = 1
      marginColor = color.mix(ground, #ffffff, 0.15)
      marginSize = fore * (0.030 to 0.042)
      blueRow = 1
      analEye = 1
      veinColor = color.set.a(rim, 230)
      veinWidth = fore * (0.011 to 0.016)
    } else if (look == 3) {
      // Morpho: electric blue with a sheen, black apex, white apex spots.
      foreRim = 0.03 to 0.08
      hindRim = foreRim
      apexPatch = 0.26 to 0.42
      subapical = 1
      subapicalColor = accent
      sheen = 0.7 to 1.0
      sheenColor = color.mix(ground, #c8f0ff, 0.5)
      outer = color.shade(ground, 18 to 34)
      deep = color.mix(ground, #101a48, 0.35 to 0.65)
      veinColor = color.set.a(rim, 90 to 150)
      if (rollA < 0.4) { marginRows = 1; marginColor = accent; marginSize = fore * 0.02 }
    } else if (look == 4) {
      // Whites and sulphurs: black or orange tip, a dark spot or two.
      foreRim = 0.0
      hindRim = 0.0
      veinColor = color.set.a(color.mix(rim, ground, 0.55), 70 to 130)
      deep = color.mix(ground, #8a8c84, 0.2 to 0.45)
      if (rollA < 0.7) { apexPatch = 0.22 to 0.36 }
      if (rollB < 0.3) {
        apexPatch = 0.42 to 0.52
        apexColor = accent2
        subapical = 2
        subapicalColor = rim
      }
      discal = 1 to 2
      if (rollC < 0.25) { discal = 0 }
      spotColor = rim
      fringeLight = color.mix(ground, #ffffff, 0.6)
      mottle = 0.05
    } else if (look == 5) {
      // Peacock: rusty field, one great eyespot on each wing.
      foreRim = 0.05 to 0.10
      hindRim = 0.10 to 0.16
      foreEyes = 1
      hindEyes = 1
      eyeSize = fore * (0.11 to 0.15)
      eyeRing = accent
      eyePupil = accent2
      hindGround = color.mix(ground, rim, 0.35 to 0.65)
      deepHind = color.mix(hindGround, hair, 0.5)
      stripes = 2 to 3
      stripeColor = rim
      checker = 1
    } else if (look == 6) {
      // Admiral: a bright band across a dark wing, white apex spots.
      diag = 1
      diagColor = accent
      subapical = 1
      subapicalColor = accent2
      hindBandLo = 0.80 to 0.86
      hindBandHi = 0.95
      hindBandColor = accent
      marginRows = 1
      marginColor = rim
      marginSize = fore * 0.02
      analEye = 2
      foreRim = 0.0
      hindRim = 0.02
      checker = 1
    } else if (look == 7) {
      // Longwing: black with a red base, a yellow band or red rays.
      diag = 1
      diagColor = accent2
      diagWidth = fore * (0.11 to 0.16)
      diagCosta = 17.0 to 21.0
      diagEnd = 44.0 to 52.0
      diagBow = 0.68 to 0.80
      deep = accent
      basalF = 0.40 to 0.55
      basalAmount = 1.0
      if (rollA < 0.5) {
        rays = 1
        rayColor = accent
        diagColor = color.mix(accent2, #ffffff, 0.3)
      } else {
        hindDiag = 1
      }
      if (rollB < 0.4) { marginRows = 1; marginColor = #f4f0e0; marginSize = fore * 0.016 }
    } else if (look == 8) {
      // Fritillary: rows of black spots and chevrons, checkered fringe.
      spotRows = 4
      spotColor = rim
      discal = 3
      foreRim = 0.04 to 0.07
      hindRim = foreRim
      marginRows = 1
      marginColor = rim
      checker = 1
      deep = color.mix(ground, #3a3a20, 0.4 to 0.7)
      veinColor = color.set.a(rim, 150 to 210)
      if (rollA < 0.4) { hindBandLo = 0.45; hindBandHi = 0.58; hindBandColor = color.mix(ground, #f8e8c0, 0.5) }
    } else if (look == 9) {
      // Blue: violet sheen, thin dark rim, white fringe, small black dots.
      rimStroke = fore * (0.025 to 0.05)
      foreRim = 0.0
      hindRim = 0.0
      sheen = 0.4 to 0.7
      sheenColor = color.mix(ground, #e8f0ff, 0.5)
      fringeLight = #f8f8f6
      fringeDark = color.mix(rim, #ffffff, 0.4)
      checker = 0
      if (rollA < 0.6) { marginRows = 1; marginColor = rim; marginSize = fore * 0.026 }
      if (rollB < 0.35) { hindBandLo = 0.80; hindBandHi = 0.90; hindBandColor = accent2 }
      deep = color.mix(ground, #4a4a6a, 0.3 to 0.5)
      veinColor = color.set.a(rim, 60 to 110)
    } else if (look == 10) {
      // Emerald and birdwing: black with iridescent green.
      diag = 1
      diagColor = accent
      diagWidth = fore * (0.16 to 0.24)
      hindDiag = 1
      sheen = 0.4 to 0.7
      sheenColor = color.mix(accent, #ffffff, 0.4)
      if (rollA < 0.45) {
        // Birdwing: green outer field, black veins, black basal half.
        diag = 0
        hindDiag = 0
        outer = accent
        deep = rim
        basalF = 0.55 to 0.65
        basalAmount = 1.0
        veinColor = rim
        veinWidth = fore * (0.016 to 0.022)
        hindGround = color.mix(accent, accent2, 0.3 to 0.9)
        deepHind = rim
      }
      if (rollB < 0.4) { marginRows = 1; marginColor = accent; marginSize = fore * 0.024 }
    } else if (look == 11) {
      // Glasswing: clear panes inside a brown rim, a white bar near the apex.
      glass = 1
      rimStroke = fore * (0.05 to 0.08)
      subapical = 3
      subapicalColor = accent
      veinColor = color.set.a(rim, 160 to 220)
      veinWidth = fore * (0.008 to 0.011)
      fringeLight = color.mix(rim, accent2, 0.5)
      mottle = 0.0
      texture = 0.2
    } else if (look == 12) {
      // Satyr: brown, eyespots with white pupils, wavy lines, mottling.
      foreEyes = 1 to 2
      hindEyes = 2 to 5
      eyeSize = fore * (0.04 to 0.07)
      eyeRing = accent
      eyePupil = accent2
      lines = 2
      mottle = 0.6 to 1.0
      foreRim = 0.03 to 0.08
      hindRim = foreRim
      if (rollA < 0.35) { hindBandLo = 0.55; hindBandHi = 0.80; hindBandColor = color.mix(ground, accent, 0.35) }
    } else {
      // Copper: fiery forewing with black spots, dark hindwing, orange rim band.
      spotRows = 2
      discal = 2
      spotColor = accent
      foreRim = 0.07 to 0.11
      hindRim = 0.04
      hindGround = color.mix(ground, rim, 0.6 to 0.85)
      deepHind = rim
      hindBandLo = 0.80
      hindBandHi = 0.94
      hindBandColor = accent2
      sheen = 0.2 to 0.5
      sheenColor = color.shade(ground, 40)
    }

    // A rare extra makes even one style vary: a stray eyespot, spots or rays.
    if (variety < 0.10 && foreEyes == 0) { foreEyes = 1; eyeSize = fore * 0.05; eyeRing = color.mix(accent2, #f8d050, 0.5); eyePupil = #f4f4f4 }
    else if (variety < 0.18 && spotRows == 0) { spotRows = 1; spotColor = color.mix(rim, ground, 0.2) }
    else if (variety < 0.24 && rays == 0) { rays = 1; rayColor = color.mix(ground, rim, 0.5) }
    // Every wing catches a little light across its middle.
    if (sheen < gloss) {
      sheen = gloss
      sheenColor = color.shade(ground, 26)
    }
    // ---- colour scheme: one recolouring over every colour role ------------
    // Fields (F), accents (A) and the rim (R) each get a hue turn, a
    // saturation and value scale and a lift towards white or black. The
    // fantasy schemes then paint the fields from hue, saturation and value.
    // Their rolls are drawn whatever the scheme, so forcing one moves nothing.
    dawn = index(16)
    dawnLow = dawnDeep[dawn].pick()
    dawnMiddle = dawnMid[dawn].pick()
    dawnHigh = dawnEdge[dawn].pick()
    dawnFlip = chance(0.3)
    hueNudge = -0.04 to 0.04
    duoTurn = pick(0.5, 0.33, -0.33, 0.25, -0.25)
    flameHue = pick(0.0, 0.0, 0.56, 0.78, 0.33, 0.9) + (-0.02 to 0.02)
    prismTurns = 0.45 to 1.0
    prismBack = chance(0.5)
    // Veins show faintly: a soft line under the blur and, with detail, a
    // translucent hairline over it.
    veinFade = 0.30 to 0.55
    kind = rolledScheme
    if (tint.a != 0) { kind = 1 }
    hairHue = hueOf(hair)
    prism = 0.0
    fire = #00000000
    tones = 0
    stars = 60
    lightVeins = 0
    hueF = 0.0
    hueOuter = 0.0
    hueA = 0.0
    satF = 1.0
    satA = 1.0
    valF = 1.0
    valA = 1.0
    liftF = 0.0
    liftA = 0.0
    liftR = 0.0
    sinkF = 0.0
    sparkle = 0
    // A wash of the scheme's own hue, so even black or grey grounds take it.
    hueBase = color.hsv(#e8584a, hueSpin, 1.0, 1.0)
    wash = hueBase
    washAmount = 0.0
    if (kind == 2) {
      // Pastel: any hue, chalky and light, rims softened into the ground.
      hueF = hueSpin
      hueOuter = hueSpin + hueSpread * 0.5
      hueA = hueSpin + accentTurn
      satF = 1.15 + schemeDepth * 0.35
      satA = 1.2
      liftF = 0.30 + schemeDepth * 0.14
      liftA = 0.24
      liftR = 0.38
      rim = color.mix(rim, ground, 0.45)
      wash = color.mix(hueBase, #ffffff, 0.5)
      washAmount = 0.22 + schemeDepth * 0.12
    } else if (kind == 3) {
      // Neon: saturated, bright, accents opposite on the wheel, black rims.
      hueF = hueSpin
      hueOuter = hueSpin + hueSpread * 0.4
      hueA = hueSpin + 0.5
      satF = 1.9
      satA = 1.9
      valF = 1.2 + schemeDepth * 0.2
      valA = 1.35
      sheen = max(sheen, 0.45)
    } else if (kind == 4) {
      // Dark: deep jewel tones, the accents left to glow against them.
      hueF = hueSpin
      hueOuter = hueSpin + hueSpread * 0.3
      hueA = hueSpin + accentTurn
      satF = 1.2
      valF = 0.42 + schemeDepth * 0.15
      sinkF = 0.1
      satA = 1.2
      valA = 1.1
      liftA = 0.12
    } else if (kind == 5) {
      // Light: ivory and frost, colour only in the accents.
      hueF = hueSpin
      hueOuter = hueSpin
      hueA = hueSpin + accentTurn
      satF = 0.9
      liftF = 0.46 + schemeDepth * 0.14
      liftR = 0.46
      satA = 1.3
      liftA = 0.08
      wash = color.mix(hueBase, #ffffff, 0.72)
      washAmount = 0.2
    } else if (kind == 6) {
      // Magic: the hue turns from base to margin, a strong sheen and glints.
      hueF = hueSpin
      hueOuter = hueSpin + hueSpread
      hueA = hueSpin + 0.5
      satF = 1.5
      valF = 1.15
      satA = 1.4
      valA = 1.25
      sheen = max(sheen, 0.8)
      sparkle = 1
    } else if (kind == 7) {
      // Aberrant: the style's own pattern in another hue.
      hueF = hueSpin
      hueOuter = hueSpin
      hueA = hueSpin
    } else if (kind == 8) {
      // Gradient: a designed gradient from the body to the margin; the
      // accents turn to the hue chosen for it.
      hueF = hueOf(dawnLow) - hairHue
      satF = 1.4
      hueA = dawnAccent[dawn] + hueNudge - hueOf(accent)
      satA = 1.3
      valA = 1.15
      liftA = 0.05
    } else if (kind == 9) {
      // Duo: the forewing in one hue, the hindwing in another.
      hueF = hueSpin - hairHue
      satF = 1.3
      hueA = hueSpin + duoTurn * 0.5 + 0.5 - hueOf(accent)
      satA = 1.3
      valA = 1.2
    } else if (kind == 10) {
      // Nebula: night-dark wings, glowing clouds, stars, neon accents.
      hueF = hueSpin - hairHue
      satF = 1.3
      valF = 0.6
      hueA = hueSpin + accentTurn - hueOf(accent)
      satA = 1.6
      valA = 1.35
      sparkle = 1
      stars = 150
      mottle = 1.0
      tones = 2
    } else if (kind == 11) {
      // Opal: pearly white with every colour drifting through it.
      hueF = hueSpin - hairHue
      satF = 0.8
      liftF = 0.45
      liftR = 0.5
      hueA = hueSpin + accentTurn - hueOf(accent)
      satA = 0.9
      valA = 1.1
      liftA = 0.25
      sparkle = 1
      tones = 1
      mottle = max(mottle, 0.6)
    } else if (kind == 12) {
      // Flame: from embers by the body to a bright margin.
      hueF = flameHue - hairHue
      satF = 1.5
      valF = 0.8
      hueA = flameHue + 0.13 - hueOf(accent)
      satA = 1.1
      valA = 1.3
      sparkle = 1
      stars = 90
    } else if (kind == 13) {
      // Frost: white and ice, light veins, glints.
      hueF = 0.5 + hueSpin * 0.25 - hairHue
      satF = 0.8
      liftF = 0.5
      liftR = 0.3
      hueA = 0.52 + hueSpin * 0.25 - hueOf(accent)
      satA = 1.2
      valA = 1.1
      lightVeins = 1
      sparkle = 1
    } else if (kind == 14) {
      // Prism: the hue turns ring by ring from the body to the margin.
      hueF = hueSpin - hairHue
      satF = 1.3
      hueA = hueSpin + 0.5 - hueOf(accent)
      satA = 1.3
      valA = 1.2
      prism = prismTurns
      if (prismBack == 1) { prism = -prismTurns }
    }
    if (kind > 7) { hueOuter = hueF }
    if (kind > 1) {
      ground = recolor(ground, hueF, satF, valF, liftF, sinkF)
      deep = recolor(deep, hueF, satF, valF, liftF * 0.7, sinkF)
      outer = recolor(outer, hueOuter, satF, valF, liftF, sinkF)
      hindGround = recolor(hindGround, hueOuter, satF, valF, liftF, sinkF)
      deepHind = recolor(deepHind, hueF, satF, valF, liftF * 0.7, sinkF)
      sheenColor = recolor(sheenColor, hueOuter + 0.08, satF, valF, liftF, 0.0)
      hair = recolor(hair, hueF, satF * 0.8, valF, liftF * 0.6, sinkF)
      rim = recolor(rim, hueF, satF, 1.0, liftR, 0.0)
      veinColor = recolor(veinColor, hueF, satF, 1.0, liftR * 0.8, 0.0)
      fringeLight = recolor(fringeLight, hueOuter, satF, valF, liftF, 0.0)
      fringeDark = recolor(fringeDark, hueF, satF, 1.0, liftR, 0.0)
      accent = recolor(accent, hueA, satA, valA, liftA, 0.0)
      accent2 = recolor(accent2, hueA + 0.12, satA, valA, liftA, 0.0)
      eyeRing = recolor(eyeRing, hueA, satA, valA, liftA, 0.0)
      eyePupil = recolor(eyePupil, hueA + 0.1, satA, valA, liftA, 0.0)
      bandColor = recolor(bandColor, hueA, satA, valA, liftA, 0.0)
      hindBandColor = recolor(hindBandColor, hueA, satA, valA, liftA, 0.0)
      diagColor = recolor(diagColor, hueA, satA, valA, liftA, 0.0)
      apexColor = recolor(apexColor, hueA, satA, valA, liftA, 0.0)
      subapicalColor = recolor(subapicalColor, hueA, satA, valA, liftA, 0.0)
      marginColor = recolor(marginColor, hueA, satA, valA, liftA, 0.0)
      spotColor = recolor(spotColor, hueA, satA, valA, liftA, 0.0)
      rayColor = recolor(rayColor, hueA, satA, valA, liftA, 0.0)
      stripeColor = recolor(stripeColor, hueA, satA, valA, liftA, 0.0)
      antennaTip = recolor(antennaTip, hueA, satA, valA, liftA, 0.0)
    }
    if (washAmount > 0.0) {
      ground = color.mix(ground, wash, washAmount)
      deep = color.mix(deep, wash, washAmount * 0.8)
      outer = color.mix(outer, wash, washAmount)
      hindGround = color.mix(hindGround, wash, washAmount)
      deepHind = color.mix(deepHind, wash, washAmount * 0.8)
      rim = color.mix(rim, wash, washAmount * 0.6)
    }
    sparkleColor = color.mix(accent2, #ffffff, 0.6)
    if (kind == 8) {
      low = color.hsv(dawnLow, hueNudge, 1.0, 1.0)
      high = color.hsv(dawnHigh, hueNudge, 1.0, 1.0)
      ground = color.hsv(dawnMiddle, hueNudge, 1.0, 1.0)
      deep = low
      outer = high
      if (dawnFlip == 1) {
        deep = high
        outer = low
      }
      deepHind = deep
      hindGround = color.mix(ground, outer, 0.7)
      sheenColor = ground
      sheen = 1.2
      fringeLight = color.mix(high, #ffffff, 0.4)
    } else if (kind == 9) {
      other = hueSpin + duoTurn
      vivid = 0.55 + schemeDepth * 0.4
      deep = hsvColor(hueSpin + 0.03, min(vivid + 0.2, 1.0), 0.38)
      ground = hsvColor(hueSpin, vivid, 0.92)
      outer = hsvColor(hueSpin - 0.03, vivid * 0.7, 1.0)
      deepHind = hsvColor(other + 0.03, min(vivid + 0.2, 1.0), 0.38)
      hindGround = hsvColor(other, vivid, 0.95)
      sheenColor = hsvColor(hueSpin + duoTurn * 0.5, 0.35, 1.0)
      sheen = 0.5
      fringeLight = color.mix(outer, #ffffff, 0.5)
    } else if (kind == 10) {
      deep = hsvColor(hueSpin, 0.9, 0.08)
      ground = hsvColor(hueSpin + 0.04, 0.85, 0.22 + schemeDepth * 0.12)
      outer = hsvColor(hueSpin + hueSpread, 0.8, 0.45 + schemeDepth * 0.2)
      deepHind = deep
      hindGround = hsvColor(hueSpin + hueSpread * 0.6, 0.8, 0.4 + schemeDepth * 0.15)
      sheenColor = hsvColor(hueSpin + hueSpread + 0.15, 0.55, 1.0)
      sheen = 0.7
      rim = hsvColor(hueSpin, 0.7, 0.05)
      fringeLight = color.mix(sheenColor, #ffffff, 0.3)
      sparkleColor = color.mix(#fff4d8, sheenColor, 0.2)
    } else if (kind == 11) {
      ground = hsvColor(hueSpin, 0.16 + schemeDepth * 0.12, 0.98)
      deep = hsvColor(hueSpin + 0.5, 0.38, 0.9)
      outer = hsvColor(hueSpin + 0.25, 0.26, 1.0)
      deepHind = hsvColor(hueSpin + 0.65, 0.38, 0.9)
      hindGround = hsvColor(hueSpin + 0.15, 0.24, 1.0)
      sheenColor = hsvColor(hueSpin + 0.35, 0.5, 1.0)
      sheen = 1.2
      fringeLight = #fffcf8
      sparkleColor = #ffffff
    } else if (kind == 12) {
      // Embers by the body, bright fire at the margin, tongues of flame.
      deep = hsvColor(flameHue - 0.02, 1.0, 0.32)
      ground = hsvColor(flameHue + 0.03, 1.0, 0.85)
      outer = hsvColor(flameHue + 0.11, 1.0, 1.0)
      deepHind = deep
      hindGround = hsvColor(flameHue + 0.06, 0.95, 0.95)
      sheenColor = hsvColor(flameHue + 0.05, 1.0, 1.0)
      sheen = 0.8
      fire = hsvColor(flameHue + 0.14, 0.45, 1.0)
      rim = hsvColor(flameHue - 0.02, 1.0, 0.12)
      fringeLight = hsvColor(flameHue + 0.13, 0.5, 1.0)
      sparkleColor = hsvColor(flameHue + 0.13, 0.45, 1.0)
    } else if (kind == 13) {
      ice = 0.5 + hueSpin * 0.25
      ground = hsvColor(ice, 0.16 + schemeDepth * 0.1, 1.0)
      deep = hsvColor(ice + 0.03, 0.55 + schemeDepth * 0.25, 0.72)
      outer = hsvColor(ice, 0.04, 1.0)
      deepHind = deep
      hindGround = hsvColor(ice - 0.02, 0.1, 1.0)
      sheenColor = hsvColor(ice - 0.05, 0.25, 1.0)
      sheen = 0.8
      rim = hsvColor(ice + 0.04, 0.55, 0.42)
      fringeLight = #ffffff
      sparkleColor = #ffffff
    } else if (kind == 14) {
      vivid = 0.55 + schemeDepth * 0.35
      ground = hsvColor(hueSpin, vivid, 0.95)
      deep = hsvColor(hueSpin, vivid, 0.6)
      outer = hsvColor(hueSpin, vivid * 0.8, 1.0)
      deepHind = deep
      hindGround = ground
      sheenColor = #ffffff
      sheen = 0.3
    }
    if (lightVeins == 1) { veinColor = color.set.a(color.mix(outer, #ffffff, 0.6), 200) }

    // ---- the motif's colours: light on a dark wing, deep on a light one ----
    figure = rolledMotif
    lum = (ground.r * 3 + ground.g * 6 + ground.b) / 10
    glow = color.mix(sheenColor, #ffffff, 0.72)
    ink = color.mix(accent, #ffffff, 0.15)
    if (lum > 165) {
      glow = color.hsv(color.mix(sheenColor, deep, 0.5), 0.0, 2.0, 0.7)
      ink = color.mix(accent, rim, 0.3)
    }
    // Per-pixel motifs need a whole program's budget; the single program
    // draws their cheaper relatives.
    if (detail == 0 && figure == 3) { figure = 2 }
    if (detail == 0 && figure == 8) { figure = 7 }
    // The edge takes the wing's own outermost colour, never a drawn outline.
    foreEdge = color.shade(outer, -14)
    if (foreRim > 0.0 || rimStroke > 0.0) { foreEdge = rim }
    hindEdge = color.shade(hindGround, -14)
    if (hindRim > 0.0 || rimStroke > 0.0) { hindEdge = rim }
    detailSeed = hash(seed ^ detailKey)
    stream_pop()

    // ---- painting ------------------------------------------------------------
    // Needs the 5,000,000 fuel budget of iprop 0.7.1: the soft art is blurred
    // on the whole half canvas before the sharp detail goes on top.
    hindOn = which != 1
    foreOn = which != 2
    rings = 20
    soft = 0.85
    if (detail == 1) {
      rings = 36
      soft = 1.3
    }
    foreGrad = stepper(deep to outer with beta(1.8, 1.0)).pick(rings)
    hindGrad = stepper(deepHind to color.shade(hindGround, 6) with beta(1.8, 1.0)).pick(rings)
    if (kind > 7) {
      // The fantasy gradients step evenly, so the colour by the body shows.
      foreGrad = stepper(deep to outer).pick(rings)
      hindGrad = stepper(deepHind to hindGround).pick(rings)
    }

    lift = fore * (0.05 to 0.08)
    veinShade = color.set.a(color.mix(veinColor, deep, 0.3), 38)
    veinSoft = color.set.a(veinColor, int(float(veinColor.a) * veinFade * 1.1))
    // Even the broad black veins of a monarch stay fine lines.
    softVein = min(veinWidth * 1.1, fore * 0.015)
    veinSharp = color.set.a(veinColor, int(float(veinColor.a) * veinFade * 0.6))
    cellGlow = color.set.a(color.mix(outer, #fff8e8, 0.35), 30)
    foreCell = 0.52 to 0.58
    foreCellLow = 0.42 to 0.48
    hindCell = 0.44 to 0.50
    hindCellLow = 0.40 to 0.46

    // In the hindwing program the forewing is not painted, but its mask still
    // trims the hindwing's sharp detail exactly where it will cover it.
    layer foreShape(alpha=surface.source_over) { poly(foreLine, #ffffff) }
    foreMask = mask.from(foreShape)
    if (hindOn) {
      layer hindShape(alpha=surface.source_over) { poly(hindLine, #ffffff) }
      hindMask = mask.from(hindShape)
      hindOnly = mask.subtract(hindMask, foreMask)
      outsideFore = mask.invert(foreMask)
    }

    // Soft art: shadows, colour fields and patterns in one layer, blurred a
    // little like a photograph, so colours meet as scales do.
    layer art(alpha=surface.source_over) {
      if (shadow == 1 && hindOn) {
        groundShadow(hindLine, hr, lift)
        groundShadow(foreLine, fr, lift)
        if (tail > 0.0) {
          drop = {0.0, lift}
          curve(tailBase + drop, (tailBase + tailTip) * 0.5 + drop, tailTip + drop, tailWidth * 1.3, #00000026)
        }
      }

      // Hindwing.
      if (hindOn && tail > 0.0) {
        // A broad base merging into the margin, a shaft and a spatulate tip.
        side = {-tailDir.y, tailDir.x} * (tailWidth * 0.45)
        neck = tailBase + tailDir * (tail * hind * 0.35)
        poly([at(hindLine, hr, tailAt - 2.6, 0.97), at(hindLine, hr, tailAt + 2.6, 0.97), neck - side, neck + side], rim)
        curve(tailBase, (tailBase + tailTip) * 0.5, tailTip, tailWidth, rim)
        dot(tailTip - tailDir * (tailWidth * 0.3), tailWidth * 1.35, rim)
        curve(tailBase + tailDir * (tailWidth * 0.8), (tailBase + tailTip) * 0.5, tailTip - tailDir * (tailWidth * 0.6),
              tailWidth * 0.32, color.mix(rim, hindGround, 0.5))
      }
      if (hindOn) {
      field(hindLine, hr, hindGrad, rim, hindRim, hindBandColor, hindBandLo, hindBandHi, hair, basalF, basalAmount,
            glass, ground, detailSeed ^ hindFieldKey, sheen, sheenColor, 22, 62, prism)
      clip(hindMask) {
        wingDetail(hindLine, hr, hind, detailSeed ^ hindDetailKey, mottle, ground, tones, sheenColor)
        if (detail == 1) { mottleField(hindLine, hr, hind, detailSeed ^ hindMottleKey, 0.4 + mottle, sheenColor, hair) }
        // Interveinal shading: scales darken along each vein and lighten in
        // the middle of each cell. The veins themselves stay soft.
        hindVeins(hindLine, hr, hindCell, hindCellLow, max(2.6, softVein * 3.0), veinShade)
        cellLight(hindLine, hr, hindGaps, hind, cellGlow)
        if (fire.a != 0) { flames(hindLine, hr, hindGaps, hind, detailSeed ^ hindFlameKey, fire, int(detail)) }
        hindVeins(hindLine, hr, hindCell, hindCellLow, softVein, veinSoft)
        if (hindEyes > 0) { eyeRow(hindLine, hr, hindGaps, hindEyes, eyeSize * 0.85, rim, eyeRing, eyePupil, hindBandLo < 1.0, 0) }
        light(hindLine, hr, hind, 40.0, sheenColor)
        if (rimStroke > 0.0) { wideStroke(hindLine, rimStroke * 2.0, rim) }
        if (hindDiag == 1) { band(hindLine, hr, hind, 13.0, 66.0, 0.55, diagWidth * 0.8, diagColor) }
        if (rays == 1) { hindRays(hindLine, hr, hind, rayColor) }
        if (spotRows > 0) { spotField(hindLine, hr, hind, hindGaps, spotRows, spotColor, detailSeed ^ hindSpotKey) }
        if (lines > 0) { wavy(hindLine, hr, 22.0, 60.0, 0.62, hind, color.set.a(rim, 150)) }
        if (blueRow == 1) { lunules(hindLine, hr, hindGaps, hindRim, hind, accent2) }
        motifArt(figure, hindLine, hr, hind, hindGaps, 24, 60, detailSeed ^ hindMotifKey, glow, ink)
        // The forewing's soft shadow on the hindwing.
        poly(shifted(foreLine, {fore * 0.008, fore * 0.022}), #00000048)
      }
      }

      // Forewing.
      if (foreOn) {
      field(foreLine, fr, foreGrad, rim, foreRim, bandColor, bandLo, bandHi, hair, basalF, basalAmount,
            glass, ground, detailSeed ^ foreFieldKey, sheen, sheenColor, 20, 62, prism)
      clip(foreMask) {
        wingDetail(foreLine, fr, fore, detailSeed ^ foreDetailKey, mottle, ground, tones, sheenColor)
        if (detail == 1) { mottleField(foreLine, fr, fore, detailSeed ^ foreMottleKey, 0.4 + mottle, sheenColor, hair) }
        foreVeins(foreLine, fr, foreCell, foreCellLow, max(2.8, softVein * 3.0), veinShade)
        cellLight(foreLine, fr, foreGaps, fore, cellGlow)
        if (fire.a != 0) { flames(foreLine, fr, foreGaps, fore, detailSeed ^ foreFlameKey, fire, int(detail)) }
        foreVeins(foreLine, fr, foreCell, foreCellLow, softVein, veinSoft)
        if (foreEyes > 0) { eyeRow(foreLine, fr, foreGaps, foreEyes, eyeSize, rim, eyeRing, eyePupil, 0, 0) }
        light(foreLine, fr, fore, 30.0, sheenColor)
        if (rimStroke > 0.0) { wideStroke(foreLine, rimStroke * 2.0, rim) }
        if (stripes > 0) { tigerStripes(foreLine, fr, fore, stripes, stripeColor, detailSeed ^ stripeKey) }
        if (diag == 1) { band(foreLine, fr, fore, diagCosta, diagEnd, diagBow, diagWidth, diagColor) }
        if (apexPatch > 0.0) {
          tip = at(foreLine, fr, 24.0, 1.04)
          dot(tip, fore * apexPatch * 2.25, color.set.a(apexColor, 70))
          dot(tip, fore * apexPatch * 2.0, apexColor)
        }
        if (spotRows > 0) { spotField(foreLine, fr, fore, foreGaps, spotRows, spotColor, detailSeed ^ foreSpotKey) }
        if (discal > 0) { discalSpots(foreLine, fr, fore, discal, spotColor) }
        if (lines > 0) { wavy(foreLine, fr, 14.0, 60.0, 0.56, fore, color.set.a(rim, 150)) }
        if (subapical > 0) { subapicalSpots(foreLine, fr, fore, subapical, subapicalColor) }
        motifArt(figure, foreLine, fr, fore, foreGaps, 22, 62, detailSeed ^ foreMotifKey, glow, ink)
      }
      }
    }
    surface.paint(art.blur(soft), blend=surface.source_over)

    // Sharp detail over the soft art: scales, the motif and hair, and with
    // detail a faint hairline over each soft vein. The hindwing's share stops
    // where the forewing covers it. A tile of per-pixel scale texture is laid
    // across both wings first.
    scales.draw(detailSeed ^ scaleKey, at={0, 0})
    darkScales = scales.outputs.dark
    scaleShade = color.set.a(color.mix(rim, #000000, 0.5), 34)
    if (hindOn) {
    clip(hindOnly) {
      scaleTexture(hindLine, darkScales, scaleShade)
      if (detail == 1) { scaleRows(hindLine, hr, hind, detailSeed ^ hindRowKey, rim, sheenColor) }
      if (sparkle == 1) { glints(hindLine, hr, detailSeed ^ hindGlintKey, sparkleColor, stars) }
      if (detail == 1) { hindVeins(hindLine, hr, hindCell, hindCellLow, softVein * 0.6, veinSharp) }
      motifSharp(figure, hindLine, hr, hind, hindGaps, 24, 60, detailSeed ^ hindMotifKey, glow, ink, int(detail))
      if (hindEyes > 0) { eyeRow(hindLine, hr, hindGaps, hindEyes, eyeSize * 0.85, rim, eyeRing, eyePupil, hindBandLo < 1.0, 1) }
      if (analEye > 0) { analSpot(hindLine, hr, eyeSize * 0.8, analEye, accent, accent2, rim) }
      if (marginRows > 0) { marginSpots(hindLine, hr, hindGaps, marginRows, hindRim, marginSize, marginColor) }
      grain(hindLine, hr, hind, texture, int(detail), detailSeed ^ hindGrainKey)
      baseHair(hr, hind, hair, detailSeed ^ hindHairKey)
    }
    clip(outsideFore) {
      innerHair(hindLine, hr, hind, hair, detailSeed ^ innerHairKey)
      edging(hindLine, hr, 24, 60, hindEdge, fringeLight, fringeDark, checker, hind)
    }
    }
    if (foreOn) {
    clip(foreMask) {
      scaleTexture(foreLine, darkScales, scaleShade)
      if (detail == 1) { scaleRows(foreLine, fr, fore, detailSeed ^ foreRowKey, rim, sheenColor) }
      if (sparkle == 1) { glints(foreLine, fr, detailSeed ^ foreGlintKey, sparkleColor, stars) }
      if (detail == 1) { foreVeins(foreLine, fr, foreCell, foreCellLow, softVein * 0.6, veinSharp) }
      motifSharp(figure, foreLine, fr, fore, foreGaps, 22, 62, detailSeed ^ foreMotifKey, glow, ink, int(detail))
      if (foreEyes > 0) { eyeRow(foreLine, fr, foreGaps, foreEyes, eyeSize, rim, eyeRing, eyePupil, 0, 1) }
      if (marginRows > 0) { marginSpots(foreLine, fr, foreGaps, marginRows, foreRim, marginSize, marginColor) }
      grain(foreLine, fr, fore, texture, int(detail), detailSeed ^ foreGrainKey)
      baseHair(fr, fore, hair, detailSeed ^ foreHairKey)
    }
    edging(foreLine, fr, 22, 62, foreEdge, fringeLight, fringeDark, checker, fore)
    antennaDraw(rootY, fore, thorax, antenna, antennaAngle, hair, antennaTip, look)
    }
    if (report == 1) {
      shift = {hueF, satF}
      level = {valF, liftF}
      dusk = {sinkF, float(rolledMotif)}
      design = {float(look), float(kind)}
    }
  }

  // ---------------------------------------------------------------- geometry

  hindKey(p: vec2, turn: f32, wide: f32, tall: f32, jitter: vec2) -> vec2 {
    q = vec2.rot({p.x * wide, p.y * tall} + jitter, turn * 0.0174532925)
    return {max(q.x, 0.05), q.y}
  }

  dir(deg: f32) -> vec2 {
    a = deg * 0.0174532925
    return {cos(a), -sin(a)}
  }

  placed(k: list<vec2>, at: vec2, s: f32) -> list<vec2> {
    return [at + k[0] * s, at + k[1] * s, at + k[2] * s, at + k[3] * s,
            at + k[4] * s, at + k[5] * s, at + k[6] * s, at + k[7] * s]
  }

  cr(p0: vec2, p1: vec2, p2: vec2, p3: vec2, t: f32) -> vec2 {
    t2 = t * t
    t3 = t2 * t
    return (p1 * 2.0 + (p2 - p0) * t + (p0 * 2.0 - p1 * 5.0 + p2 * 4.0 - p3) * t2
            + (p1 * 3.0 - p0 - p2 * 3.0 + p3) * t3) * 0.5
  }

  // Point i of 96 on the closed spline through the keys; sp holds the margin
  // start and end (fractions of the outline), scallop depth and count.
  op(k: list<vec2>, sp: list<f32>, i: i32) -> vec2 {
    n = list.len(k)
    s = float(i) * float(n) / 96.0
    j = int(s)
    p = cr(k[(j + n - 1) % n], k[j], k[(j + 1) % n], k[(j + 2) % n], s - float(j))
    g = float(i) / 96.0
    if (sp[2] > 0.0 && g > sp[0] && g < sp[1]) {
      u = (g - sp[0]) / (sp[1] - sp[0])
      taper = smoothstep(0.0, 0.12, u) * (1.0 - smoothstep(0.88, 1.0, u))
      wave = sqrt(abs(sin(3.14159265 * sp[3] * u)))
      p = p + vec2.normalize(p - k[0]) * (sp[2] * (wave - 0.75) * taper)
    }
    return p
  }

  outline(k: list<vec2>, sp: list<f32>) -> list<vec2> {
    return [
      op(k, sp, 0), op(k, sp, 1), op(k, sp, 2), op(k, sp, 3), op(k, sp, 4), op(k, sp, 5), op(k, sp, 6), op(k, sp, 7),
      op(k, sp, 8), op(k, sp, 9), op(k, sp, 10), op(k, sp, 11), op(k, sp, 12), op(k, sp, 13), op(k, sp, 14), op(k, sp, 15),
      op(k, sp, 16), op(k, sp, 17), op(k, sp, 18), op(k, sp, 19), op(k, sp, 20), op(k, sp, 21), op(k, sp, 22), op(k, sp, 23),
      op(k, sp, 24), op(k, sp, 25), op(k, sp, 26), op(k, sp, 27), op(k, sp, 28), op(k, sp, 29), op(k, sp, 30), op(k, sp, 31),
      op(k, sp, 32), op(k, sp, 33), op(k, sp, 34), op(k, sp, 35), op(k, sp, 36), op(k, sp, 37), op(k, sp, 38), op(k, sp, 39),
      op(k, sp, 40), op(k, sp, 41), op(k, sp, 42), op(k, sp, 43), op(k, sp, 44), op(k, sp, 45), op(k, sp, 46), op(k, sp, 47),
      op(k, sp, 48), op(k, sp, 49), op(k, sp, 50), op(k, sp, 51), op(k, sp, 52), op(k, sp, 53), op(k, sp, 54), op(k, sp, 55),
      op(k, sp, 56), op(k, sp, 57), op(k, sp, 58), op(k, sp, 59), op(k, sp, 60), op(k, sp, 61), op(k, sp, 62), op(k, sp, 63),
      op(k, sp, 64), op(k, sp, 65), op(k, sp, 66), op(k, sp, 67), op(k, sp, 68), op(k, sp, 69), op(k, sp, 70), op(k, sp, 71),
      op(k, sp, 72), op(k, sp, 73), op(k, sp, 74), op(k, sp, 75), op(k, sp, 76), op(k, sp, 77), op(k, sp, 78), op(k, sp, 79),
      op(k, sp, 80), op(k, sp, 81), op(k, sp, 82), op(k, sp, 83), op(k, sp, 84), op(k, sp, 85), op(k, sp, 86), op(k, sp, 87),
      op(k, sp, 88), op(k, sp, 89), op(k, sp, 90), op(k, sp, 91), op(k, sp, 92), op(k, sp, 93), op(k, sp, 94), op(k, sp, 95)
    ]
  }

  // The outline scaled by f about c.
  sc(p: list<vec2>, c: vec2, f: f32) -> list<vec2> {
    return [
      c + (p[0] - c) * f, c + (p[1] - c) * f, c + (p[2] - c) * f, c + (p[3] - c) * f, c + (p[4] - c) * f, c + (p[5] - c) * f,
      c + (p[6] - c) * f, c + (p[7] - c) * f, c + (p[8] - c) * f, c + (p[9] - c) * f, c + (p[10] - c) * f, c + (p[11] - c) * f,
      c + (p[12] - c) * f, c + (p[13] - c) * f, c + (p[14] - c) * f, c + (p[15] - c) * f, c + (p[16] - c) * f, c + (p[17] - c) * f,
      c + (p[18] - c) * f, c + (p[19] - c) * f, c + (p[20] - c) * f, c + (p[21] - c) * f, c + (p[22] - c) * f, c + (p[23] - c) * f,
      c + (p[24] - c) * f, c + (p[25] - c) * f, c + (p[26] - c) * f, c + (p[27] - c) * f, c + (p[28] - c) * f, c + (p[29] - c) * f,
      c + (p[30] - c) * f, c + (p[31] - c) * f, c + (p[32] - c) * f, c + (p[33] - c) * f, c + (p[34] - c) * f, c + (p[35] - c) * f,
      c + (p[36] - c) * f, c + (p[37] - c) * f, c + (p[38] - c) * f, c + (p[39] - c) * f, c + (p[40] - c) * f, c + (p[41] - c) * f,
      c + (p[42] - c) * f, c + (p[43] - c) * f, c + (p[44] - c) * f, c + (p[45] - c) * f, c + (p[46] - c) * f, c + (p[47] - c) * f,
      c + (p[48] - c) * f, c + (p[49] - c) * f, c + (p[50] - c) * f, c + (p[51] - c) * f, c + (p[52] - c) * f, c + (p[53] - c) * f,
      c + (p[54] - c) * f, c + (p[55] - c) * f, c + (p[56] - c) * f, c + (p[57] - c) * f, c + (p[58] - c) * f, c + (p[59] - c) * f,
      c + (p[60] - c) * f, c + (p[61] - c) * f, c + (p[62] - c) * f, c + (p[63] - c) * f, c + (p[64] - c) * f, c + (p[65] - c) * f,
      c + (p[66] - c) * f, c + (p[67] - c) * f, c + (p[68] - c) * f, c + (p[69] - c) * f, c + (p[70] - c) * f, c + (p[71] - c) * f,
      c + (p[72] - c) * f, c + (p[73] - c) * f, c + (p[74] - c) * f, c + (p[75] - c) * f, c + (p[76] - c) * f, c + (p[77] - c) * f,
      c + (p[78] - c) * f, c + (p[79] - c) * f, c + (p[80] - c) * f, c + (p[81] - c) * f, c + (p[82] - c) * f, c + (p[83] - c) * f,
      c + (p[84] - c) * f, c + (p[85] - c) * f, c + (p[86] - c) * f, c + (p[87] - c) * f, c + (p[88] - c) * f, c + (p[89] - c) * f,
      c + (p[90] - c) * f, c + (p[91] - c) * f, c + (p[92] - c) * f, c + (p[93] - c) * f, c + (p[94] - c) * f, c + (p[95] - c) * f
    ]
  }

  shifted(p: list<vec2>, d: vec2) -> list<vec2> {
    return [
      p[0] + d, p[1] + d, p[2] + d, p[3] + d, p[4] + d, p[5] + d, p[6] + d, p[7] + d,
      p[8] + d, p[9] + d, p[10] + d, p[11] + d, p[12] + d, p[13] + d, p[14] + d, p[15] + d,
      p[16] + d, p[17] + d, p[18] + d, p[19] + d, p[20] + d, p[21] + d, p[22] + d, p[23] + d,
      p[24] + d, p[25] + d, p[26] + d, p[27] + d, p[28] + d, p[29] + d, p[30] + d, p[31] + d,
      p[32] + d, p[33] + d, p[34] + d, p[35] + d, p[36] + d, p[37] + d, p[38] + d, p[39] + d,
      p[40] + d, p[41] + d, p[42] + d, p[43] + d, p[44] + d, p[45] + d, p[46] + d, p[47] + d,
      p[48] + d, p[49] + d, p[50] + d, p[51] + d, p[52] + d, p[53] + d, p[54] + d, p[55] + d,
      p[56] + d, p[57] + d, p[58] + d, p[59] + d, p[60] + d, p[61] + d, p[62] + d, p[63] + d,
      p[64] + d, p[65] + d, p[66] + d, p[67] + d, p[68] + d, p[69] + d, p[70] + d, p[71] + d,
      p[72] + d, p[73] + d, p[74] + d, p[75] + d, p[76] + d, p[77] + d, p[78] + d, p[79] + d,
      p[80] + d, p[81] + d, p[82] + d, p[83] + d, p[84] + d, p[85] + d, p[86] + d, p[87] + d,
      p[88] + d, p[89] + d, p[90] + d, p[91] + d, p[92] + d, p[93] + d, p[94] + d, p[95] + d
    ]
  }

  // The outline scaled by its own factor at every point.
  scj(p: list<vec2>, c: vec2, f: list<f32>) -> list<vec2> {
    return [
      c + (p[0] - c) * f[0], c + (p[1] - c) * f[1], c + (p[2] - c) * f[2], c + (p[3] - c) * f[3], c + (p[4] - c) * f[4], c + (p[5] - c) * f[5],
      c + (p[6] - c) * f[6], c + (p[7] - c) * f[7], c + (p[8] - c) * f[8], c + (p[9] - c) * f[9], c + (p[10] - c) * f[10], c + (p[11] - c) * f[11],
      c + (p[12] - c) * f[12], c + (p[13] - c) * f[13], c + (p[14] - c) * f[14], c + (p[15] - c) * f[15], c + (p[16] - c) * f[16], c + (p[17] - c) * f[17],
      c + (p[18] - c) * f[18], c + (p[19] - c) * f[19], c + (p[20] - c) * f[20], c + (p[21] - c) * f[21], c + (p[22] - c) * f[22], c + (p[23] - c) * f[23],
      c + (p[24] - c) * f[24], c + (p[25] - c) * f[25], c + (p[26] - c) * f[26], c + (p[27] - c) * f[27], c + (p[28] - c) * f[28], c + (p[29] - c) * f[29],
      c + (p[30] - c) * f[30], c + (p[31] - c) * f[31], c + (p[32] - c) * f[32], c + (p[33] - c) * f[33], c + (p[34] - c) * f[34], c + (p[35] - c) * f[35],
      c + (p[36] - c) * f[36], c + (p[37] - c) * f[37], c + (p[38] - c) * f[38], c + (p[39] - c) * f[39], c + (p[40] - c) * f[40], c + (p[41] - c) * f[41],
      c + (p[42] - c) * f[42], c + (p[43] - c) * f[43], c + (p[44] - c) * f[44], c + (p[45] - c) * f[45], c + (p[46] - c) * f[46], c + (p[47] - c) * f[47],
      c + (p[48] - c) * f[48], c + (p[49] - c) * f[49], c + (p[50] - c) * f[50], c + (p[51] - c) * f[51], c + (p[52] - c) * f[52], c + (p[53] - c) * f[53],
      c + (p[54] - c) * f[54], c + (p[55] - c) * f[55], c + (p[56] - c) * f[56], c + (p[57] - c) * f[57], c + (p[58] - c) * f[58], c + (p[59] - c) * f[59],
      c + (p[60] - c) * f[60], c + (p[61] - c) * f[61], c + (p[62] - c) * f[62], c + (p[63] - c) * f[63], c + (p[64] - c) * f[64], c + (p[65] - c) * f[65],
      c + (p[66] - c) * f[66], c + (p[67] - c) * f[67], c + (p[68] - c) * f[68], c + (p[69] - c) * f[69], c + (p[70] - c) * f[70], c + (p[71] - c) * f[71],
      c + (p[72] - c) * f[72], c + (p[73] - c) * f[73], c + (p[74] - c) * f[74], c + (p[75] - c) * f[75], c + (p[76] - c) * f[76], c + (p[77] - c) * f[77],
      c + (p[78] - c) * f[78], c + (p[79] - c) * f[79], c + (p[80] - c) * f[80], c + (p[81] - c) * f[81], c + (p[82] - c) * f[82], c + (p[83] - c) * f[83],
      c + (p[84] - c) * f[84], c + (p[85] - c) * f[85], c + (p[86] - c) * f[86], c + (p[87] - c) * f[87], c + (p[88] - c) * f[88], c + (p[89] - c) * f[89],
      c + (p[90] - c) * f[90], c + (p[91] - c) * f[91], c + (p[92] - c) * f[92], c + (p[93] - c) * f[93], c + (p[94] - c) * f[94], c + (p[95] - c) * f[95]
    ]
  }

  // Three smooth wobble patterns per wing, one noise value per outline
  // point; every ring scales the outline by f along one of them, so colour
  // boundaries run in organic waves rather than exact copies of the margin.
  waves(z: f32) -> list<f32> {
    return [
      noise.grad(float(0) * 0.19, z, 0x2d), noise.grad(float(1) * 0.19, z, 0x2d), noise.grad(float(2) * 0.19, z, 0x2d), noise.grad(float(3) * 0.19, z, 0x2d),
      noise.grad(float(4) * 0.19, z, 0x2d), noise.grad(float(5) * 0.19, z, 0x2d), noise.grad(float(6) * 0.19, z, 0x2d), noise.grad(float(7) * 0.19, z, 0x2d),
      noise.grad(float(8) * 0.19, z, 0x2d), noise.grad(float(9) * 0.19, z, 0x2d), noise.grad(float(10) * 0.19, z, 0x2d), noise.grad(float(11) * 0.19, z, 0x2d),
      noise.grad(float(12) * 0.19, z, 0x2d), noise.grad(float(13) * 0.19, z, 0x2d), noise.grad(float(14) * 0.19, z, 0x2d), noise.grad(float(15) * 0.19, z, 0x2d),
      noise.grad(float(16) * 0.19, z, 0x2d), noise.grad(float(17) * 0.19, z, 0x2d), noise.grad(float(18) * 0.19, z, 0x2d), noise.grad(float(19) * 0.19, z, 0x2d),
      noise.grad(float(20) * 0.19, z, 0x2d), noise.grad(float(21) * 0.19, z, 0x2d), noise.grad(float(22) * 0.19, z, 0x2d), noise.grad(float(23) * 0.19, z, 0x2d),
      noise.grad(float(24) * 0.19, z, 0x2d), noise.grad(float(25) * 0.19, z, 0x2d), noise.grad(float(26) * 0.19, z, 0x2d), noise.grad(float(27) * 0.19, z, 0x2d),
      noise.grad(float(28) * 0.19, z, 0x2d), noise.grad(float(29) * 0.19, z, 0x2d), noise.grad(float(30) * 0.19, z, 0x2d), noise.grad(float(31) * 0.19, z, 0x2d),
      noise.grad(float(32) * 0.19, z, 0x2d), noise.grad(float(33) * 0.19, z, 0x2d), noise.grad(float(34) * 0.19, z, 0x2d), noise.grad(float(35) * 0.19, z, 0x2d),
      noise.grad(float(36) * 0.19, z, 0x2d), noise.grad(float(37) * 0.19, z, 0x2d), noise.grad(float(38) * 0.19, z, 0x2d), noise.grad(float(39) * 0.19, z, 0x2d),
      noise.grad(float(40) * 0.19, z, 0x2d), noise.grad(float(41) * 0.19, z, 0x2d), noise.grad(float(42) * 0.19, z, 0x2d), noise.grad(float(43) * 0.19, z, 0x2d),
