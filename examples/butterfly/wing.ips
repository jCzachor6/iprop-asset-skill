      noise.grad(float(48) * 0.19, z, 0x2d), noise.grad(float(49) * 0.19, z, 0x2d), noise.grad(float(50) * 0.19, z, 0x2d), noise.grad(float(51) * 0.19, z, 0x2d),
      noise.grad(float(52) * 0.19, z, 0x2d), noise.grad(float(53) * 0.19, z, 0x2d), noise.grad(float(54) * 0.19, z, 0x2d), noise.grad(float(55) * 0.19, z, 0x2d),
      noise.grad(float(56) * 0.19, z, 0x2d), noise.grad(float(57) * 0.19, z, 0x2d), noise.grad(float(58) * 0.19, z, 0x2d), noise.grad(float(59) * 0.19, z, 0x2d),
      noise.grad(float(60) * 0.19, z, 0x2d), noise.grad(float(61) * 0.19, z, 0x2d), noise.grad(float(62) * 0.19, z, 0x2d), noise.grad(float(63) * 0.19, z, 0x2d),
      noise.grad(float(64) * 0.19, z, 0x2d), noise.grad(float(65) * 0.19, z, 0x2d), noise.grad(float(66) * 0.19, z, 0x2d), noise.grad(float(67) * 0.19, z, 0x2d),
      noise.grad(float(68) * 0.19, z, 0x2d), noise.grad(float(69) * 0.19, z, 0x2d), noise.grad(float(70) * 0.19, z, 0x2d), noise.grad(float(71) * 0.19, z, 0x2d),
