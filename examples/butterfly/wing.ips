      noise.grad(float(92) * 0.19, z, 0x2d), noise.grad(float(93) * 0.19, z, 0x2d), noise.grad(float(94) * 0.19, z, 0x2d), noise.grad(float(95) * 0.19, z, 0x2d)
    ]
  }

  // The outline scaled about c by f, wobbled by amp along the pattern w.
  scw(p: list<vec2>, c: vec2, f: f32, amp: f32, w: list<f32>) -> list<vec2> {
    return [
      c + (p[0] - c) * min(f * (1.0 + amp * w[0]), 0.996), c + (p[1] - c) * min(f * (1.0 + amp * w[1]), 0.996), c + (p[2] - c) * min(f * (1.0 + amp * w[2]), 0.996),
      c + (p[3] - c) * min(f * (1.0 + amp * w[3]), 0.996), c + (p[4] - c) * min(f * (1.0 + amp * w[4]), 0.996), c + (p[5] - c) * min(f * (1.0 + amp * w[5]), 0.996),
      c + (p[6] - c) * min(f * (1.0 + amp * w[6]), 0.996), c + (p[7] - c) * min(f * (1.0 + amp * w[7]), 0.996), c + (p[8] - c) * min(f * (1.0 + amp * w[8]), 0.996),
      c + (p[9] - c) * min(f * (1.0 + amp * w[9]), 0.996), c + (p[10] - c) * min(f * (1.0 + amp * w[10]), 0.996), c + (p[11] - c) * min(f * (1.0 + amp * w[11]), 0.996),
      c + (p[12] - c) * min(f * (1.0 + amp * w[12]), 0.996), c + (p[13] - c) * min(f * (1.0 + amp * w[13]), 0.996), c + (p[14] - c) * min(f * (1.0 + amp * w[14]), 0.996),
      c + (p[15] - c) * min(f * (1.0 + amp * w[15]), 0.996), c + (p[16] - c) * min(f * (1.0 + amp * w[16]), 0.996), c + (p[17] - c) * min(f * (1.0 + amp * w[17]), 0.996),
      c + (p[18] - c) * min(f * (1.0 + amp * w[18]), 0.996), c + (p[19] - c) * min(f * (1.0 + amp * w[19]), 0.996), c + (p[20] - c) * min(f * (1.0 + amp * w[20]), 0.996),
      c + (p[21] - c) * min(f * (1.0 + amp * w[21]), 0.996), c + (p[22] - c) * min(f * (1.0 + amp * w[22]), 0.996), c + (p[23] - c) * min(f * (1.0 + amp * w[23]), 0.996),
      c + (p[24] - c) * min(f * (1.0 + amp * w[24]), 0.996), c + (p[25] - c) * min(f * (1.0 + amp * w[25]), 0.996), c + (p[26] - c) * min(f * (1.0 + amp * w[26]), 0.996),
      c + (p[27] - c) * min(f * (1.0 + amp * w[27]), 0.996), c + (p[28] - c) * min(f * (1.0 + amp * w[28]), 0.996), c + (p[29] - c) * min(f * (1.0 + amp * w[29]), 0.996),
      c + (p[30] - c) * min(f * (1.0 + amp * w[30]), 0.996), c + (p[31] - c) * min(f * (1.0 + amp * w[31]), 0.996), c + (p[32] - c) * min(f * (1.0 + amp * w[32]), 0.996),
      c + (p[33] - c) * min(f * (1.0 + amp * w[33]), 0.996), c + (p[34] - c) * min(f * (1.0 + amp * w[34]), 0.996), c + (p[35] - c) * min(f * (1.0 + amp * w[35]), 0.996),
      c + (p[36] - c) * min(f * (1.0 + amp * w[36]), 0.996), c + (p[37] - c) * min(f * (1.0 + amp * w[37]), 0.996), c + (p[38] - c) * min(f * (1.0 + amp * w[38]), 0.996),
      c + (p[39] - c) * min(f * (1.0 + amp * w[39]), 0.996), c + (p[40] - c) * min(f * (1.0 + amp * w[40]), 0.996), c + (p[41] - c) * min(f * (1.0 + amp * w[41]), 0.996),
      c + (p[42] - c) * min(f * (1.0 + amp * w[42]), 0.996), c + (p[43] - c) * min(f * (1.0 + amp * w[43]), 0.996), c + (p[44] - c) * min(f * (1.0 + amp * w[44]), 0.996),
      c + (p[45] - c) * min(f * (1.0 + amp * w[45]), 0.996), c + (p[46] - c) * min(f * (1.0 + amp * w[46]), 0.996), c + (p[47] - c) * min(f * (1.0 + amp * w[47]), 0.996),
      c + (p[48] - c) * min(f * (1.0 + amp * w[48]), 0.996), c + (p[49] - c) * min(f * (1.0 + amp * w[49]), 0.996), c + (p[50] - c) * min(f * (1.0 + amp * w[50]), 0.996),
      c + (p[51] - c) * min(f * (1.0 + amp * w[51]), 0.996), c + (p[52] - c) * min(f * (1.0 + amp * w[52]), 0.996), c + (p[53] - c) * min(f * (1.0 + amp * w[53]), 0.996),
      c + (p[54] - c) * min(f * (1.0 + amp * w[54]), 0.996), c + (p[55] - c) * min(f * (1.0 + amp * w[55]), 0.996), c + (p[56] - c) * min(f * (1.0 + amp * w[56]), 0.996),
      c + (p[57] - c) * min(f * (1.0 + amp * w[57]), 0.996), c + (p[58] - c) * min(f * (1.0 + amp * w[58]), 0.996), c + (p[59] - c) * min(f * (1.0 + amp * w[59]), 0.996),
      c + (p[60] - c) * min(f * (1.0 + amp * w[60]), 0.996), c + (p[61] - c) * min(f * (1.0 + amp * w[61]), 0.996), c + (p[62] - c) * min(f * (1.0 + amp * w[62]), 0.996),
      c + (p[63] - c) * min(f * (1.0 + amp * w[63]), 0.996), c + (p[64] - c) * min(f * (1.0 + amp * w[64]), 0.996), c + (p[65] - c) * min(f * (1.0 + amp * w[65]), 0.996),
      c + (p[66] - c) * min(f * (1.0 + amp * w[66]), 0.996), c + (p[67] - c) * min(f * (1.0 + amp * w[67]), 0.996), c + (p[68] - c) * min(f * (1.0 + amp * w[68]), 0.996),
      c + (p[69] - c) * min(f * (1.0 + amp * w[69]), 0.996), c + (p[70] - c) * min(f * (1.0 + amp * w[70]), 0.996), c + (p[71] - c) * min(f * (1.0 + amp * w[71]), 0.996),
      c + (p[72] - c) * min(f * (1.0 + amp * w[72]), 0.996), c + (p[73] - c) * min(f * (1.0 + amp * w[73]), 0.996), c + (p[74] - c) * min(f * (1.0 + amp * w[74]), 0.996),
      c + (p[75] - c) * min(f * (1.0 + amp * w[75]), 0.996), c + (p[76] - c) * min(f * (1.0 + amp * w[76]), 0.996), c + (p[77] - c) * min(f * (1.0 + amp * w[77]), 0.996),
      c + (p[78] - c) * min(f * (1.0 + amp * w[78]), 0.996), c + (p[79] - c) * min(f * (1.0 + amp * w[79]), 0.996), c + (p[80] - c) * min(f * (1.0 + amp * w[80]), 0.996),
      c + (p[81] - c) * min(f * (1.0 + amp * w[81]), 0.996), c + (p[82] - c) * min(f * (1.0 + amp * w[82]), 0.996), c + (p[83] - c) * min(f * (1.0 + amp * w[83]), 0.996),
      c + (p[84] - c) * min(f * (1.0 + amp * w[84]), 0.996), c + (p[85] - c) * min(f * (1.0 + amp * w[85]), 0.996), c + (p[86] - c) * min(f * (1.0 + amp * w[86]), 0.996),
      c + (p[87] - c) * min(f * (1.0 + amp * w[87]), 0.996), c + (p[88] - c) * min(f * (1.0 + amp * w[88]), 0.996), c + (p[89] - c) * min(f * (1.0 + amp * w[89]), 0.996),
      c + (p[90] - c) * min(f * (1.0 + amp * w[90]), 0.996), c + (p[91] - c) * min(f * (1.0 + amp * w[91]), 0.996), c + (p[92] - c) * min(f * (1.0 + amp * w[92]), 0.996),
      c + (p[93] - c) * min(f * (1.0 + amp * w[93]), 0.996), c + (p[94] - c) * min(f * (1.0 + amp * w[94]), 0.996), c + (p[95] - c) * min(f * (1.0 + amp * w[95]), 0.996)
    ]
  }

  // A point at outline position u (fractional index), a fraction f of the way
  // from the root r to the margin.
  at(p: list<vec2>, r: vec2, u: f32, f: f32) -> vec2 {
    i = int(floor(u))
    t = u - float(i)
    q = p[(i + 96) % 96] * (1.0 - t) + p[(i + 97) % 96] * t
    return r + (q - r) * f
  }

  // ---------------------------------------------------------------- painting

  dot(p: vec2, d: f32, c: color) { curve(p, p, p, d, c) }

  dash(a: vec2, b: vec2, d: f32, c: color) { curve(a, (a + b) * 0.5, b, d, c) }

  stroke(p: list<vec2>, width: f32, c: color) {
    for i in 0..96 { dash(p[i], p[(i + 1) % 96], width, c) }
  }

  // A wide stroke through every other point: quadratic curves through the
  // midpoints, half as many and just as smooth.
  wideStroke(p: list<vec2>, width: f32, c: color) {
    for i in 0..48 {
      a = (p[i * 2] + p[(i * 2 + 1) % 96]) * 0.5
      b = (p[(i * 2 + 2) % 96] + p[(i * 2 + 1) % 96]) * 0.5
      curve(a, p[(i * 2 + 1) % 96], b, width, c)
    }
  }

  groundShadow(p: list<vec2>, r: vec2, lift: f32) {
    poly(sc(shifted(p, {0.0, lift * 1.4}), r + {0.0, lift}, 1.09), #0000000c)
    poly(sc(shifted(p, {0.0, lift * 1.2}), r + {0.0, lift}, 1.05), #00000014)
    poly(sc(shifted(p, {0.0, lift}), r + {0.0, lift}, 1.01), #0000001c)
  }

  // The colour field: outlines scaled about the root from the margin inwards,
  // so the rim, the bands and the basal gradient all follow the wing shape.
  field(p: list<vec2>, r: vec2, grad: list<color>, rim: color, rimW: f32, band: color,
        lo: f32, hi: f32, hair: color, basalF: f32, basalAmount: f32, glass: i32, ground: color, key: i32,
        sheen: f32, sheenColor: color, m0: i32, m1: i32, prism: f32) {
    if (glass == 1) {
      poly(p, color.set.a(ground, 70))
      poly(sc(p, r, basalF), color.set.a(color.mix(ground, hair, 0.5), 150))
      return;
    }
    stream_push(key)
    top = 1.0
    if (rimW > 0.0) {
      poly(p, rim)
      top = 1.0 - rimW
    }
    n = list.len(grad)
    fs = stepper(0.06 to top with beta(1.0, 1.5, 0.06, top)).pick(n)
    zk = float(key & 255)
    wave0 = waves(zk)
    wave1 = waves(zk + 3.7)
    wave2 = waves(zk + 7.3)
    // A band gets rings of its own at both edges, so its width never
    // depends on where the stepped rings fall.
    hiDone = 0
    loDone = 0
    for i in 0..n {
      k = n - 1 - i
      f = fs[k]
      c = grad[k]
      // Prism: every ring a little further round the colour wheel.
      if (prism != 0.0) { c = color.hsv(c, prism * f, 1.0, 1.0) }
      if (hiDone == 0 && hi < 1.0 && f < hi) {
        hiDone = 1
        poly(scj(p, r, sampler(hi * 0.99 to min(hi * 1.01, 0.996)).pick(96)), color.mix(c, band, 0.92))
      }
      if (loDone == 0 && hi < 1.0 && f < lo) {
        loDone = 1
        poly(scj(p, r, sampler(lo * 0.99 to lo * 1.01).pick(96)), color.mix(c, band, 0.12))
      }
      // Iridescence: a broad band of lighter scales across the middle.
      if (sheen > 0.0) { c = color.mix(c, sheenColor, sheen * 0.5 * exp(-(f - 0.6) * (f - 0.6) * 18.0)) }
      if (f > lo && f < hi) {
        edge = min(f - lo, hi - f) / max(hi - lo, 0.01)
        c = color.mix(c, band, smoothstep(0.0, 0.18, edge) * 0.92 + 0.08)
      }
      if (k == n - 1 && rimW > 0.0) { c = color.mix(c, rim, 0.5) }
      if (f < basalF) { c = color.mix(c, hair, basalAmount * pow(1.0 - f / basalF, 0.8) * 0.85) }
      if (k == n - 1 && rimW <= 0.0) { poly(p, c) }
      else {
        wave = wave0
        if (k % 3 == 1) { wave = wave1 }
        else if (k % 3 == 2) { wave = wave2 }
        poly(scw(p, r, f, 0.012 + 0.03 * min(f / top, 1.0 - f / top) * 2.0, wave), c)
      }
    }
    // Scales blend across colour boundaries: soft strokes along the rim's
    // inner edge and both edges of a band, over the margin only.
    if (rimW > 0.0) {
      softEdge(sc(p, r, top), m0, m1, max(2.0, rimW * 40.0), color.set.a(rim, 70))
      softEdge(sc(p, r, top - 0.012), m0, m1, 1.6, color.set.a(rim, 60))
    }
    if (hi < 1.0) {
      softEdge(sc(p, r, hi), m0, m1, 2.6, color.set.a(band, 90))
      softEdge(sc(p, r, lo), m0, m1, 2.6, color.set.a(band, 70))
    }
    stream_pop()
  }

  softEdge(p: list<vec2>, m0: i32, m1: i32, width: f32, c: color) {
    for i in m0 / 2..m1 / 2 {
      a = (p[i * 2] + p[i * 2 + 1]) * 0.5
      b = (p[i * 2 + 2] + p[i * 2 + 1]) * 0.5
      curve(a, p[i * 2 + 1], b, width, c)
    }
  }

  // Mottling at three scales, light and dark: broad clouds, patches and
  // specks. Under the art blur they read as soft multi-octave noise.
  // tones 1 makes them every pastel colour (opal), 2 lights the clouds.
  wingDetail(p: list<vec2>, r: vec2, len: f32, key: i32, mottle: f32, ground: color, tones: i32, cloud: color) {
    stream_push(key)
    if (mottle > 0.0) {
      sizes = [0.12, 0.055, 0.022]
      counts = [10, 36, 90]
      for s in 0..3 {
        n = counts[s]
        us = sampler(20.0 to 64.0).pick(n)
        fs = sampler(0.12 to 0.98 with beta(2.0, 1.2)).pick(n)
        for i in 0..n {
          tone = wingShades[index(3)]
          bright = 0
          if (tone.r == 255) {
            tone = color.mix(ground, #ffffff, 0.5)
            bright = 1
          }
          alpha = int(mottle * (10.0 to 30.0) * (1.0 + float(s) * 0.4))
          if (tones == 1) {
            tone = hsvColor(0.0 to 1.0, 0.55, 1.0)
            alpha = alpha * 5 / 2
          } else if (tones == 2 && bright == 1) {
            tone = cloud
            alpha = alpha * 3
          }
          dot(at(p, r, us[i], fs[i]), len * sizes[s] * (0.6 to 1.3), color.set.a(tone, alpha))
        }
      }
    }
    stream_pop()
  }

  // Scale texture: hundreds of single-pixel flecks, light and dark.
  grain(p: list<vec2>, r: vec2, len: f32, amount: f32, detail: i32, key: i32) {
    stream_push(key)
    batches = 1
    streaks = 180
    if (detail == 1) {
      batches = 3
      streaks = 300
    }
    for b in 0..batches { flecks(p, r, min(int(len * 2.6 * amount), 256)) }
    // Rows of scales: faint streaks running out from the base.
    for i in 0..streaks {
      u = 22.0 to 64.0
      f = 0.08 to 0.88
      a = at(p, r, u, f)
      e = at(p, r, u + (-0.4 to 0.4), f + (0.04 to 0.14))
      line(a.x, a.y, e.x, e.y, 1, pick(#0000000e, #ffffff0b))
    }
    stream_pop()
  }

  // The outline's bounding box in whole pixels, clipped to the canvas:
  // {x0, y0} and {x1, y1} as two points of one list.
  box(p: list<vec2>) -> list<vec2> {
    x0 = p[0].x
    y0 = p[0].y
    x1 = x0
    y1 = y0
    for i in 1..96 {
      x0 = min(x0, p[i].x)
      y0 = min(y0, p[i].y)
      x1 = max(x1, p[i].x)
      y1 = max(y1, p[i].y)
    }
    return [{max(floor(x0), 0.0), max(floor(y0), 0.0)}, {min(ceil(x1) + 1.0, 128.0), min(ceil(y1) + 1.0, 256.0)}]
  }

  // Per-pixel mottling from three octaves of gradient noise, with light
  // falling from above: lighter scales towards the top of the wing, darker
  // towards the bottom. Drawn under the blur, so it reads as soft cloud.
  mottleField(p: list<vec2>, r: vec2, len: f32, key: i32, amount: f32, glow: color, shade: color) {
    b = box(p)
    scale = 3.2 / len
    tall = max(b[1].y - b[0].y, 1.0)
    for y in int(b[0].y)..int(b[1].y) {
      fy = float(y) * scale
      above = (b[1].y - float(y)) / tall - 0.5
      for x in int(b[0].x)..int(b[1].x) {
        n = noise.fbm(float(x) * scale, fy, 3, key) * amount + above * 0.35
        if (n > 0.0) { pixel(x, y, color.set.a(glow, int(min(n, 1.0) * 70.0))) }
        else { pixel(x, y, color.set.a(shade, int(min(-n, 1.0) * 80.0))) }
      }
    }
  }

  // Rows of scales: noise stretched along the rays from the wing root, fine
  // across them and long along them, painted sharp over the blurred art.
  scaleRows(p: list<vec2>, r: vec2, len: f32, key: i32, dark: color, glow: color) {
    b = box(p)
    for y in int(b[0].y)..int(b[1].y) {
      dy = float(y) + 0.5 - r.y
      for x in int(b[0].x)..int(b[1].x) {
        dx = float(x) + 0.5 - r.x
        n = noise.grad(atan2(dy, dx) * len * 0.9, sqrt(dx * dx + dy * dy) * 0.22, key)
        if (n > 0.18) { pixel(x, y, color.set.a(glow, int((n - 0.18) * 60.0))) }
        else if (n < -0.18) { pixel(x, y, color.set.a(dark, int((-n - 0.18) * 70.0))) }
      }
    }
  }

  // The scale tile laid edge to edge over a wing's bounding box; offset
  // views share the tile's buffer, so only the painting costs anything.
  scaleTexture(p: list<vec2>, dark: mask, shade: color) {
    x0 = p[0].x
    y0 = p[0].y
    x1 = x0
    y1 = y0
    for i in 1..96 {
      x0 = min(x0, p[i].x)
      y0 = min(y0, p[i].y)
      x1 = max(x1, p[i].x)
      y1 = max(y1, p[i].y)
    }
    for ty in int(floor(y0 / 40.0))..int(floor(y1 / 40.0)) + 1 {
      for tx in int(floor(x0 / 40.0))..int(floor(x1 / 40.0)) + 1 {
        surface.paint(mask.offset(dark, tx * 40, ty * 40), color=shade)
      }
    }
  }

  // A colour turned, rescaled in saturation and value, then lifted towards
  // white or sunk towards black. Alpha is kept.
  recolor(c: color, hue: f32, sat: f32, val: f32, lift: f32, sink: f32) -> color {
    d = color.hsv(c, hue, sat, val)
    d = color.mix(d, #ffffff, lift)
    d = color.mix(d, #000000, sink)
    return color.set.a(d, c.a)
  }

  // A colour from its hue in turns, saturation and value (all 0..1).
  hsvColor(h: f32, s: f32, v: f32) -> color {
    return color.hsv(#ff0000, h, s, v)
  }

  // The hue of a colour in turns; 0 for greys.
  hueOf(c: color) -> f32 {
    r = float(c.r)
    g = float(c.g)
    b = float(c.b)
    hi = max(r, max(g, b))
    d = hi - min(r, min(g, b))
    if (d <= 0.0) { return 0.0 }
    h = 4.0 + (r - g) / d
    if (hi == r) { h = (g - b) / d }
    else if (hi == g) { h = 2.0 + (b - r) / d }
    h = h / 6.0
    if (h < 0.0) { h = h + 1.0 }
    return h
  }

  // Iridescent glints: bright single scales catching the light (magic),
  // or the stars of a nebula.
  glints(p: list<vec2>, r: vec2, key: i32, c: color, n: i32) {
    stream_push(key)
    us = sampler(20.0 to 64.0).pick(n)
    fs = sampler(0.15 to 0.97 with beta(2.0, 1.3)).pick(n)
    for i in 0..n {
      q = at(p, r, us[i], fs[i])
      pixel(int(q.x), int(q.y), color.set.a(c, 120 to 230))
      if (chance(0.25)) { dot(q, 1.6, color.set.a(c, 70)) }
    }
    stream_pop()
  }

  // Single-pixel scale flecks, light and dark.
  flecks(p: list<vec2>, r: vec2, n: i32) {
    us = sampler(22.0 to 64.0).pick(n)
    fs = sampler(0.05 to 0.99 with beta(2.0, 1.0)).pick(n)
    for i in 0..n {
      q = at(p, r, us[i], fs[i])
      pixel(int(q.x), int(q.y), pick(#00000018, #ffffff16))
    }
  }

  // A lighter streak through the middle of every cell between the veins.
  cellLight(p: list<vec2>, r: vec2, gaps: list<f32>, len: f32, c: color) {
    for i in 0..list.len(gaps) {
      a = at(p, r, gaps[i], 0.36)
      b = at(p, r, gaps[i], 0.84)
      m = at(p, r, gaps[i], 0.6)
      curve(a, m, b, len * 0.075, c)
    }
  }

  // Light falling on the wing from above: a broad soft glow.
  light(p: list<vec2>, r: vec2, len: f32, u: f32, c: color) {
    centre = at(p, r, u, 0.55)
    sizes = stepper(len * 0.25 to len * 0.9).pick(4)
    for i in 0..4 { dot(centre, sizes[3 - i], color.set.a(c, 12)) }
  }

  baseHair(r: vec2, len: f32, hair: color, key: i32) {
    stream_push(key)
    for i in 0..26 {
      a = -1.3 to 1.0
      l = len * (0.06 to 0.20)
      d = vec2.rot({1.0, 0.0}, a)
      q = r + d * (len * (0.0 to 0.05))
      e = q + d * l
      line(q.x, q.y, e.x, e.y, 1, color.set.a(color.shade(hair, -10 to 30), 70 to 150))
    }
    stream_pop()
  }

  // Long fine hairs along the hindwing's inner margin, beside the abdomen.
  innerHair(p: list<vec2>, r: vec2, len: f32, hair: color, key: i32) {
    stream_push(key)
    for i in 0..22 {
      u = 64.0 to 92.0
      q = at(p, r, u, 0.995)
      d = vec2.rot(vec2.normalize(q - r), -0.9 to -0.3)
      line(q.x, q.y, q.x + d.x * len * (0.03 to 0.08), q.y + d.y * len * (0.03 to 0.08), 1,
           color.set.a(color.mix(hair, #d8d0c0, 0.3), 60 to 130))
    }
    stream_pop()
  }

  // An AA stroke over the polygon edge, then a short fringe of cilia.
  edging(p: list<vec2>, r: vec2, m0: i32, m1: i32, edge: color, light: color, dark: color, checker: i32, len: f32) {
    stroke(p, 0.9, color.set.a(edge, 200))
    reach = max(1.6, len * 0.02)
    for i in m0..m1 {
      d = vec2.normalize(p[i] - r)
      c = light
      if (checker == 1 && (i / 3) % 2 == 0) { c = dark }
      // Cilia: fine translucent hairs, two per outline step.
      a = p[i] + d * 0.3
      b = p[i] + d * reach
      line(a.x, a.y, b.x, b.y, 1, color.set.a(c, 125))
      m = (p[i] + p[i + 1]) * 0.5 + d * 0.3
      e = m + d * (reach * 0.8)
      line(m.x, m.y, e.x, e.y, 1, color.set.a(c, 90))
    }
  }

  vein(a: vec2, b: vec2, w: f32, c: color) {
    m = (a + b) * 0.5
    n = vec2.normalize({b.y - a.y, a.x - b.x}) * (vec2.len(b - a) * 0.04)
    curve(a, m + n * 0.5, m + n, w * 1.25, c)
    curve(m + n, m + n * 0.5 + (b - m) * 0.5, b, w, color.set.a(c, c.a * 3 / 4))
  }

  foreVeins(p: list<vec2>, r: vec2, cu: f32, cl: f32, w: f32, c: color) {
    up = at(p, r, 28.0, cu)
    lo = at(p, r, 47.0, cl)
    vein(r, at(p, r, 13.0, 1.0), w * 0.9, c)
    vein(r, up, w * 1.2, c)
    vein(r, lo, w * 1.2, c)
    vein(up, lo, w * 0.7, c)
    vein(r + (up - r) * 0.55, at(p, r, 17.0, 1.0), w, c)
    vein(r + (up - r) * 0.8, at(p, r, 20.5, 1.0), w, c)
    vein(up, at(p, r, 24.0, 1.0), w, c)
    vein(up, at(p, r, 27.0, 1.0), w, c)
    vein(up, at(p, r, 30.0, 1.0), w, c)
    vein(up, at(p, r, 34.0, 1.0), w, c)
    vein((up + lo) * 0.5, at(p, r, 40.0, 1.0), w, c)
    vein(lo, at(p, r, 46.0, 1.0), w, c)
    vein(r + (lo - r) * 0.8, at(p, r, 51.0, 1.0), w, c)
    vein(r + (lo - r) * 0.55, at(p, r, 56.0, 1.0), w, c)
    vein(r, at(p, r, 62.0, 1.0), w, c)
  }

  hindVeins(p: list<vec2>, r: vec2, cu: f32, cl: f32, w: f32, c: color) {
    up = at(p, r, 30.0, cu)
    lo = at(p, r, 50.0, cl)
    vein(r, at(p, r, 18.0, 1.0), w, c)
    vein(r, up, w * 1.2, c)
    vein(r, lo, w * 1.2, c)
    vein(up, lo, w * 0.7, c)
    vein(up, at(p, r, 27.0, 1.0), w, c)
    vein(up, at(p, r, 32.0, 1.0), w, c)
    vein((up + lo) * 0.5, at(p, r, 38.0, 1.0), w, c)
    vein(lo, at(p, r, 44.0, 1.0), w, c)
    vein(r + (lo - r) * 0.8, at(p, r, 49.0, 1.0), w, c)
    vein(r + (lo - r) * 0.55, at(p, r, 54.0, 1.0), w, c)
    vein(r, at(p, r, 62.0, 1.0), w, c)
    vein(r, at(p, r, 70.0, 1.0), w * 0.8, c)
  }

  // White or coloured dots in the dark rim, one or two rows between veins.
  marginSpots(p: list<vec2>, r: vec2, gaps: list<f32>, rows: i32, rimW: f32, d: f32, c: color) {
    outerF = 1.0 - max(rimW, 0.06) * 0.35
    innerF = 1.0 - max(rimW, 0.06) * 0.72
    for i in 0..list.len(gaps) {
      u = gaps[i]
      dot(at(p, r, u, outerF), d * 1.6, color.set.a(c, 60))
      blob(at(p, r, u, outerF), d, c, i * 3)
      if (rows > 1) {
        blob(at(p, r, u - 0.8, innerF), d * 0.8, c, i * 3 + 1)
        blob(at(p, r, u + 0.8, innerF), d * 0.8, c, i * 3 + 2)
      }
    }
  }

  // Blue crescents along the inner edge of a swallowtail's dark rim.
  lunules(p: list<vec2>, r: vec2, gaps: list<f32>, rimW: f32, len: f32, c: color) {
    f = 1.0 - rimW * 0.92
    for i in 1..list.len(gaps) {
      u = gaps[i]
      a = at(p, r, u - 1.5, f)
      b = at(p, r, u + 1.5, f)
      m = at(p, r, u, f + 0.03)
      curve(a, m, b, len * 0.045, color.set.a(c, 110))
      curve(a, m, b, len * 0.026, c)
    }
  }

  // A row of light spots across the dark apex (and the glasswing's bar).
  subapicalSpots(p: list<vec2>, r: vec2, len: f32, kind: i32, c: color) {
    if (kind == 3) {
      dash(at(p, r, 18.0, 0.80), at(p, r, 33.0, 0.80), len * 0.07, color.set.a(c, 230))
      return;
    }
    n = 4
    if (kind == 2) { n = 3 }
    us = stepper(17.0 to 31.0).pick(n)
    for i in 0..n {
      f = 0.80 + float(i % 2) * 0.04
      a = at(p, r, us[i], f - 0.03)
      b = at(p, r, us[i], f + 0.04)
      dash(a, b, len * (0.06 - float(i) * 0.006), color.set.a(c, 70))
      dash(a, b, len * (0.036 - float(i) * 0.004), c)
    }
  }

  // Eyespots between the veins, drawn in two parts: part 0 paints the soft
  // rings into the blurred art, part 1 the sharp pupil and its highlight.
  eyeRow(p: list<vec2>, r: vec2, gaps: list<f32>, count: i32, size: f32, dark: color,
         ring: color, pupil: color, inBand: i32, part: i32) {
    n = list.len(gaps)
    first = 1
    if (count == 1) { first = 2 }
    for i in 0..count {
      g = gaps[min(first + i * max(1, (n - 2) / max(count, 1)), n - 1)]
      s = size * (1.0 - 0.18 * float(i % 2))
      if (count == 1) { s = size }
      f = 0.70
      if (inBand == 1) { f = 0.80 }
      q = at(p, r, g, f)
      eye(q, vec2.normalize(q - r), s, dark, ring, pupil, part)
    }
  }

  // An eyespot drawn slightly long along its cell (direction d), with its
  // pupil nudged towards the margin and a crescent of light above it.
  eye(c: vec2, d: vec2, s: f32, dark: color, ring: color, pupil: color, part: i32) {
    e = d * (s * 0.16)
    if (part == 0) {
      radii = stepper(s * 1.15 to s * 2.0).pick(5)
      tones = stepper(color.mix(ring, dark, 0.6) to color.shade(ring, 18)).pick(5)
      curve(c - e, c, c + e, s * 2.4, color.set.a(dark, 160))
      for i in 0..5 { curve(c - e, c, c + e, radii[4 - i], tones[i]) }
      curve(c - e, c, c + e, s * 1.15, dark)
      curve(c, c + e, c + e * 1.6, s * 0.7, color.mix(pupil, dark, 0.45))
      return;
    }
    q = c + d * (s * 0.12)
    dot(q, s * 0.44, pupil)
    curve(q + {-s * 0.34, -s * 0.02}, q + {-s * 0.12, -s * 0.44}, q + {s * 0.24, -s * 0.30},
          max(0.8, s * 0.15), #ffffffb8)
  }

  // An irregular spot: three overlapping discs turned by the golden angle.
  blob(q: vec2, s: f32, c: color, k: i32) {
    a = float(k) * 2.39996
    dot(q, s, c)
    dot(q + {cos(a), sin(a)} * (s * 0.24), s * 0.72, c)
    dot(q + {cos(a + 2.2), sin(a + 2.2)} * (s * 0.22), s * 0.62, c)
  }

  // Swallowtail's orange and blue anal spot, or the admiral's blue one.
  analSpot(p: list<vec2>, r: vec2, s: f32, kind: i32, a: color, b: color, dark: color) {
    c = at(p, r, 58.0, 0.84)
    if (kind == 1) {
      dot(c, s * 1.7, color.mix(#e85a1a, a, 0.2))
      dot(c, s * 0.9, b)
      dot(c + {0.0, s * 0.35}, s * 0.7, dark)
    } else {
      dot(c, s * 1.3, b)
      dot(c, s * 0.6, dark)
    }
  }

  // Tiger stripes running back from the costa, shortening towards the apex.
  tigerStripes(p: list<vec2>, r: vec2, len: f32, count: i32, c: color, key: i32) {
    stream_push(key)
    starts = stepper(4.0 to 19.0).pick(count)
    for i in 0..count {
      u = starts[i] + (-0.8 to 0.8)
      reach = 1.02 - float(i) * (0.10 to 0.16)
      a = at(p, r, u, 1.06)
      b = at(p, r, 90.0 - float(i) * (6.0 to 8.0), reach)
      m = (a + b) * 0.5 + (r - (a + b) * 0.5) * (0.0 to 0.12)
      w = len * (0.055 to 0.09)
      curve(a, m, b, w * 1.3, color.set.a(c, 80))
      curve(a, m, b, w, c)
    }
    stream_pop()
  }

  // A broad band across the wing from the costa towards the tornus, bowed
  // towards the root.
  band(p: list<vec2>, r: vec2, len: f32, uc: f32, ut: f32, bow: f32, width: f32, c: color) {
    a = at(p, r, uc, 1.06)
    b = at(p, r, ut, 1.06)
    m = at(p, r, (uc + ut) * 0.5, bow)
    if (width < len * 0.15) { curve(a, m, b, width * 1.25, color.set.a(c, 90)) }
    curve(a, m, b, width, c)
  }

  // Coloured rays along the cells of the hindwing (longwings).
  hindRays(p: list<vec2>, r: vec2, len: f32, c: color) {
    for i in 0..6 {
      u = 28.0 + float(i) * 5.5
      curve(at(p, r, u, 0.42), at(p, r, u, 0.65), at(p, r, u, 0.9), len * 0.05, color.set.a(c, 170))
    }
  }

  // Rows of dark spots and chevrons between the veins (fritillaries).
  spotField(p: list<vec2>, r: vec2, len: f32, gaps: list<f32>, rows: i32, c: color, key: i32) {
    stream_push(key)
    levels = stepper(0.42 to 0.86).pick(rows)
    for k in 0..rows {
      for i in 0..list.len(gaps) {
        if (chance(0.85)) {
          q = at(p, r, gaps[i] + (-0.7 to 0.7), levels[k] + (-0.03 to 0.03))
          if (k == rows - 1 && rows > 2) {
            w = at(p, r, gaps[i] - 1.4, levels[k] - 0.04)
            e = at(p, r, gaps[i] + 1.4, levels[k] - 0.04)
            curve(w, q + (q - (w + e) * 0.5) * 0.6, e, len * 0.018, c)
          } else {
            s = len * (0.022 to 0.04)
            dot(q, s * 1.7, color.set.a(c, 55))
            blob(q, s, c, k * 11 + i)
          }
        }
      }
    }
    stream_pop()
  }

  // Bars and spots in and at the end of the discal cell.
  discalSpots(p: list<vec2>, r: vec2, len: f32, count: i32, c: color) {
    dot(at(p, r, 38.0, 0.56), len * 0.09, color.set.a(c, 60))
    blob(at(p, r, 38.0, 0.56), len * 0.055, c, 5)
    if (count > 1) { blob(at(p, r, 48.0, 0.64), len * 0.045, c, 9) }
    if (count > 2) {
      dash(at(p, r, 27.0, 0.36), at(p, r, 45.0, 0.30), len * 0.02, c)
      dash(at(p, r, 28.0, 0.24), at(p, r, 45.0, 0.20), len * 0.02, c)
    }
  }

  // Thin wavy lines parallel to the margin (satyrs, viceroy).
  wavy(p: list<vec2>, r: vec2, u0: f32, u1: f32, f: f32, len: f32, c: color) {
    steps = 10
    for i in 0..steps {
      ua = u0 + (u1 - u0) * float(i) / float(steps)
      ub = u0 + (u1 - u0) * float(i + 1) / float(steps)
      fa = f + 0.03 * sin(float(i) * 2.1)
      fb = f + 0.03 * sin(float(i + 1) * 2.1)
      dash(at(p, r, ua, fa), at(p, r, ub, fb), max(0.9, len * 0.012), c)
    }
  }

  // ---------------------------------------------------------------- motifs

  // The motif's soft share, painted into the art before the blur.
  motifArt(figure: i32, p: list<vec2>, r: vec2, len: f32, gaps: list<f32>, m0: i32, m1: i32,
           key: i32, glow: color, ink: color) {
    if (figure == 2) { ripples(p, r, key, color.set.a(glow, 120), color.set.a(ink, 80), 2.2) }
    else if (figure == 3) { marble(p, len, key, color.set.a(glow, 230), color.set.a(ink, 170)) }
    else if (figure == 4) { lace(p, r, gaps, len, m0, m1, 2.2, color.set.a(glow, 90)) }
    else if (figure == 6) { orbs(p, r, gaps, len, key, glow, ink, 0) }
    else if (figure == 7) { sunburst(p, r, gaps, color.set.a(glow, 130), color.set.a(ink, 85)) }
    else if (figure == 8) { shimmer(p, r, len, key, 72) }
    else if (figure == 9) { pearls(p, r, len, m0, m1, 1.8, color.set.a(glow, 80)) }
  }

  // The motif's crisp share, painted over the scales. The single program
  // leaves the ripples soft.
  motifSharp(figure: i32, p: list<vec2>, r: vec2, len: f32, gaps: list<f32>, m0: i32, m1: i32,
             key: i32, glow: color, ink: color, detail: i32) {
    if (figure == 2 && detail == 1) { ripples(p, r, key, color.set.a(glow, 80), color.set.a(ink, 50), 0.8) }
    else if (figure == 4) { lace(p, r, gaps, len, m0, m1, 1.0, color.set.a(glow, 245)) }
    else if (figure == 5) { stardust(p, r, len, key, glow) }
    else if (figure == 6) { orbs(p, r, gaps, len, key, glow, ink, 1) }
    else if (figure == 9) { pearls(p, r, len, m0, m1, 1.0, glow) }
  }

  // Agate ripples: rings of the outline, wobbled, alternately pale and dark.
  ripples(p: list<vec2>, r: vec2, key: i32, pale: color, dark: color, width: f32) {
    stream_push(key)
    n = 5 to 9
    fs = stepper(0.26 to 0.93).pick(n)
    wave = waves(float(key & 255) + 11.0)
    for i in 0..n {
      c = pale
      if (i % 2 == 1) { c = dark }
      wideStroke(scw(p, r, fs[i] + (-0.02 to 0.02), 0.06, wave), width * (0.7 to 1.3), c)
    }
    stream_pop()
  }

  // Marbling: thin stripes of domain-warped noise, pale veins and dark ones.
  marble(p: list<vec2>, len: f32, key: i32, pale: color, dark: color) {
    b = box(p)
    s = 2.4 / len
    for y in int(b[0].y)..int(b[1].y) {
      fy = float(y) * s
      for x in int(b[0].x)..int(b[1].x) {
        fx = float(x) * s
        v = sin((warp(fx, fy, 2.2, key) * 2.6 + fx * 0.5 + fy * 0.3) * 6.2831853)
        if (v > 0.6) { pixel(x, y, color.set.a(pale, int((v - 0.6) * 2.5 * float(pale.a)))) }
        else if (v < -0.75) { pixel(x, y, color.set.a(dark, int((-v - 0.75) * 4.0 * float(dark.a)))) }
      }
    }
  }

  // Lace: a dotted line inside the margin, a scallop over every cell and a
  // bead under it.
  lace(p: list<vec2>, r: vec2, gaps: list<f32>, len: f32, m0: i32, m1: i32, width: f32, c: color) {
    for i in m0..m1 { dot(at(p, r, float(i) + 0.5, 0.93), max(1.3, len * 0.014) * width, c) }
    for i in 0..list.len(gaps) {
      g = gaps[i]
      curve(at(p, r, g - 1.7, 0.85), at(p, r, g, 0.68), at(p, r, g + 1.7, 0.85), max(1.0, len * 0.011) * width, c)
      dot(at(p, r, g, 0.79), max(2.0, len * 0.03) * width, c)
    }
  }

  // Stardust: stars of every size, the largest with four rays, and one
  // small constellation.
  stardust(p: list<vec2>, r: vec2, len: f32, key: i32, c: color) {
    stream_push(key)
    n = 30 to 50
    us = sampler(21.0 to 63.0).pick(n)
    fs = sampler(0.2 to 0.95 with beta(2.0, 1.4)).pick(n)
    for i in 0..n {
      q = at(p, r, us[i], fs[i])
      s = 0.8 to 2.8 with beta(1.2, 3.0, 0.8, 2.8)
      dot(q, s * 3.4, color.set.a(c, 40))
      dot(q, s, c)
      if (s > 1.6) {
        reach = s * 2.8
        line(q.x - reach, q.y, q.x + reach, q.y, 1, color.set.a(c, 110))
        line(q.x, q.y - reach, q.x, q.y + reach, 1, color.set.a(c, 110))
      }
    }
    u = 26.0 to 56.0
    f = 0.45 to 0.8
    prev = at(p, r, u, f)
    for i in 0..5 {
      u = clamp(u + (-4.0 to 4.0), 21.0, 63.0)
      f = clamp(f + (-0.12 to 0.12), 0.25, 0.92)
      q = at(p, r, u, f)
      line(prev.x, prev.y, q.x, q.y, 1, color.set.a(c, 70))
      dot(q, 5.0, color.set.a(c, 40))
      dot(q, 1.8, color.set.a(c, 240))
      prev = q
    }
    stream_pop()
  }

  // Orbs: translucent bubbles in the cells; part 0 their soft glow, part 1
  // the bubble with its lit rim and highlight.
  orbs(p: list<vec2>, r: vec2, gaps: list<f32>, len: f32, key: i32, a: color, b: color, part: i32) {
    stream_push(key)
    for i in 0..list.len(gaps) {
      show = chance(0.75)
      q = at(p, r, gaps[i] + (-0.6 to 0.6), 0.42 to 0.86)
      s = len * (0.08 to 0.15)
      c = a
      if (chance(0.4)) { c = b }
      if (show == 1 && part == 0) { dot(q, s * 1.5, color.set.a(c, 80)) }
      if (show == 1 && part == 1) {
        dot(q, s, color.set.a(c, 120))
        dot(q, s * 0.8, color.set.a(color.mix(c, #ffffff, 0.35), 70))
        dot(q + {-s * 0.16, -s * 0.18}, s * 0.26, #ffffffa0)
      }
    }
    stream_pop()
  }

  // Tongues of flame licking out along every cell, a white-hot line in each
  // (with detail).
  flames(p: list<vec2>, r: vec2, gaps: list<f32>, len: f32, key: i32, c: color, detail: i32) {
    stream_push(key)
    for i in 0..list.len(gaps) {
      g = gaps[i] + (-0.5 to 0.5)
      sway = 0.6 to 1.4
      if (chance(0.5)) { sway = -sway }
      // An S of two strokes, tapering from a broad base to a fine tip.
      w = len * (0.07 to 0.1)
      a = at(p, r, g, 0.28 to 0.4)
      m = at(p, r, g + sway, 0.52)
      n = at(p, r, g, 0.68 to 0.74)
      q = at(p, r, g - sway, 0.84)
      e = at(p, r, g + sway * 0.4, 0.95 to 1.03)
      curve(a, m, n, w, color.set.a(c, 110))
      curve(n, q, e, w * 0.55, color.set.a(c, 120))
      if (detail == 1) {
        curve(a, m, n, w * 0.45, color.set.a(color.mix(c, #ffffff, 0.5), 140))
        curve(n, q, e, w * 0.25, color.set.a(color.mix(c, #ffffff, 0.5), 150))
      }
    }
    stream_pop()
  }

  // Sunburst: soft rays from the root, one along every cell.
  sunburst(p: list<vec2>, r: vec2, gaps: list<f32>, a: color, b: color) {
    for i in 0..list.len(gaps) {
      c = a
      if (i % 2 == 1) { c = b }
      g = gaps[i]
      poly([at(p, r, g, 0.1), at(p, r, g - 1.2, 0.99), at(p, r, g + 1.2, 0.99)], c)
    }
  }

  // A holographic sheen: the hue turns with the angle about the root and
  // the distance from it, broken a little by noise. It lies under the blur,
  // so it is computed in blocks of two by two pixels.
  shimmer(p: list<vec2>, r: vec2, len: f32, key: i32, alpha: i32) {
    b = box(p)
    turn = float(key & 1023) / 1024.0
    for by in int(b[0].y) / 2..int(b[1].y) / 2 + 1 {
      y = by * 2
      dy = float(y) + 1.0 - r.y
      for bx in int(b[0].x) / 2..int(b[1].x) / 2 + 1 {
        x = bx * 2
        dx = float(x) + 1.0 - r.x
        h = turn + atan2(dy, dx) * 0.4 + sqrt(dx * dx + dy * dy) / len * 1.2
            + noise.grad(float(x) * 0.06, float(y) * 0.06, key) * 0.2
        rect(x, y, 2, 2, color.set.a(hsvColor(h, 0.6, 1.0), alpha))
      }
    }
  }

  // Pearls: two rows of beads along the margin, each with a highlight.
  pearls(p: list<vec2>, r: vec2, len: f32, m0: i32, m1: i32, spread: f32, c: color) {
    for k in 0..2 {
      f = 0.86 - float(k) * 0.14
      s = len * (0.042 - float(k) * 0.01)
      for i in m0 / 2..m1 / 2 {
        q = at(p, r, float(i * 2 + k), f)
        dot(q, s * spread, c)
        if (spread < 1.5) { dot(q + {-s * 0.18, -s * 0.2}, s * 0.36, #ffffffb0) }
      }
    }
  }

  antennaDraw(rootY: f32, fore: f32, thorax: f32, antenna: f32, angle: f32, hair: color, tip: color, look: i32) {
    headR = max(2.5, fore * 0.045)
    headY = rootY - thorax * fore * 0.72 - headR * 0.75
    base = {headR * 0.42, headY - headR * 0.72}
    d = dir(angle)
    len = antenna * fore
    end = base + d * len
    bend = base + dir(angle - 8.0) * (len * 0.55)
    shaft = color.shade(hair, -20)
    curve(base, bend, end, max(0.9, fore * 0.009), shaft)
    if (look == 1 || look == 6 || look == 8) {
      for i in 1..9 {
        t = float(i) / 10.0
        q = base * ((1.0 - t) * (1.0 - t)) + bend * (2.0 * t * (1.0 - t)) + end * (t * t)
        dot(q, max(0.8, fore * 0.008), color.set.a(#f0ece0, 150))
      }
    }
    club = end - d * (len * 0.16)
    curve(club, (club + end) * 0.5, end, max(2.0, fore * 0.026), shaft)
    dot(end - d * (len * 0.03), max(1.2, fore * 0.014), tip)
  }
}
